{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/375","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Frederick R. Weisman Art Museum","type":"Name"},{"classified_as":[{"_label":"subsidiary","id":"https://vocab.getty.edu/aat/300258351"}],"content":"College of Liberal Arts","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Frederick R. Weisman Art Museum","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":["University of Minnesota Gallery","University Art Museum"],"type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Weisman Art Museum is an art museum at the University of Minnesota in Minneapolis, Minnesota. Founded in 1934 as University Gallery, the museum was originally housed in an upper floor of the university's Northrop Auditorium. In 1993, the museum moved to its current building, designed by the Canadian-born American architect Frank Gehry, and renamed in honor of art collector and philanthropist Frederick R. Weisman. Widely known as a \"modern art museum,\" its 20,000+ acquisitions include large collections of traditional Korean furniture and modern American art, including collections of work by Marsden Hartley, Alfred Maurer, Charles Biederman. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}