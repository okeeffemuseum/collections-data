{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/387","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Denver Art Museum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Denver Art Museum","type":"Name"},{"classified_as":[{"_label":"subsidiary","id":"https://vocab.getty.edu/aat/300258351"}],"content":"Children's Museum of the Denver Art Museum","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Denver Art Museum (DAM) is an art museum located in the Civic Center of Denver, Colorado. With an encyclopedic collection of more than 70,000 diverse works from across the centuries and world, the DAM is one of the largest art museums between the West Coast and Chicago. It is known for its collection of American Indian art, as well as The Petrie Institute of Western American Art, which oversees the museum's Western art collection. The museum's Martin Building (formerly known as the North Building) was designed by famed Italian architect Gio Ponti in 1971. In 2018, the museum began a transformational $150 million renovation project to unify the campus and revitalize Ponti's original structure, including the creation of new exhibition spaces, two new dining options, and a new welcome center. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}