{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/341","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Museum of Contemporary Art San Diego","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Museum of Contemporary Art San Diego","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":["La Jolla Art Center","San Diego Museum of Art","The Fine Arts Gallery of San Diego"],"type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The San Diego Museum of Art is a fine arts museum located at 1450 El Prado in Balboa Park in San Diego, California that houses a broad collection with particular strength in Spanish art.  The San Diego Museum of Art opened as The Fine Arts Gallery of San Diego on February 28, 1926, and changed its name to the San Diego Museum of Art in 1978.  The official Balboa Park website calls the San Diego Museum of Art \"the region's oldest and largest art museum\".  Nearly half a million people visit the museum each year. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}