{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1818","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Columbus College of Art and Design","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Columbus College of Art and Design","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Columbus College of Art \u0026 Design (CCAD) is a private art school in Columbus, Ohio. It was founded in 1879 as the Columbus Art School and is one of the oldest private art and design colleges in the United States. Located in downtown Columbus, CCAD's campus consists of 14 buildings (including 2 residence halls) on 9 acres (36,000 m2) and is adjacent to the Columbus Museum of Art. Approximately 1,090 full-time students are enrolled. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}