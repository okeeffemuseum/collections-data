{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/2073","identified_by":[{"classified_as":[{"_label":"authorized","id":"https://data.okeeffemuseum.org/terms/local/authorized"}],"content":"Hammer Museum","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Armand Hammer Museum of Art","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Armand Hammer Museum of Art","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Hammer Museum is an art museum and cultural center known for its artist-centric and progressive array of exhibitions and public programs. It is affiliated with the University of California, Los Angeles. Founded in 1990 by the entrepreneur-industrialist Armand Hammer to house his personal art collection, the museum has since expanded its scope. The Hammer Museum hosts over 300 programs throughout the year, from lectures, symposia, and readings to concerts and film screenings. As of June 2025, the museum's collections, exhibitions, and programs are free to all visitors. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}