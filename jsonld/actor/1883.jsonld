{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1883","identified_by":[{"classified_as":[{"_label":"authorized","id":"https://data.okeeffemuseum.org/terms/local/authorized"}],"content":"Institute of Puerto Rican Culture","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Institute of Puerto Rican Culture","type":"Name"},{"classified_as":[{"_label":"vernacular name","id":"https://data.okeeffemuseum.org/terms/local/vernacular-name"}],"content":"Instituto de Cultura Puertorriqueña","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Instituto de Cultura Puertorriqueña (English: Institute of Puerto Rican Culture), or ICP for short, is an institution of the Government of Puerto Rico responsible for the establishment of the cultural policies required in order to study, preserve, promote, enrich, and diffuse the cultural values of Puerto Rico. Since October 1992, its headquarters have been located at the site of the old colonial Spanish Welfare House in Old San Juan. The ICP was created by order of Law Number 89, signed June 21, 1955, and it started operating in November of that year. Its first Executive Director was Dr. Ricardo Alegría. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}