{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1821","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"University of Saint Joseph","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":"Saint Joseph College","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"University of Saint Joseph","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The University of Saint Joseph is a private Catholic university in West Hartford, Connecticut, United States. It was founded in 1932 as a women's college by the Sisters of Mercy of Connecticut and began admitting men to its undergraduate programs in 2018. The university is accredited by the New England Commission of Higher Education. There are 857 undergraduate and 959 graduate students (fall 2024). \nUSJ has more than 30 bachelor's degree programs and more than 30 graduate programs including master's programs and two doctoral programs (Doctor of Nursing Practice and Doctor of Pharmacy). (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}