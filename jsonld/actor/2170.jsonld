{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/2170","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"","id":"https://data.okeeffemuseum.org/terms/local/"}],"content":"New Mexico Highlands University","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"New Mexico Highlands University","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"New Mexico Highlands University (NMHU or Highlands) is a public university and research institution in Las Vegas, New Mexico, United States. Founded in 1893, it has satellite campuses in Santa Fe, Albuquerque, Rio Rancho, Farmington and Roswell. NMHU has an average annual enrollment of approximately 3,000 students and offers a variety of undergraduate and graduate degree programs across six schools and colleges, as well as online. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}