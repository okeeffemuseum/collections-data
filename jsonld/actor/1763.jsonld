{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1763","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Duncan","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Duncan  Phillips","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":" Phillips","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Duncan Phillips (26 June 1886 – 9 May 1966) was a Washington, D.C., based art collector and critic who played a seminal role in introducing modern art to America. The grandson of James Laughlin, a banker and co-founder of the Jones and Laughlin Steel Company, Phillips was born in Pittsburgh and moved with his family to Washington, D.C. in 1895. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}