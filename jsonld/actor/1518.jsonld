{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1518","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"University of Washington, Henry Art Gallery","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"University of Washington, Henry Art Gallery","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Henry Art Gallery (\"The Henry\") is a contemporary art museum located on the University of Washington campus in Seattle, Washington. Located on the west edge of the university's campus along 15th Avenue N.E. in the University District, it was founded in February, 1927, and was the first public art museum in the state of Washington. The original building was designed by Bebb and Gould. It was expanded in 1997 to 40,000 square feet (3,700 m2), at which time the 154-seat auditorium was added. The addition/expansion was designed by Gwathmey Siegel \u0026 Associates Architects. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}