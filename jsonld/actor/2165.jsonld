{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/2165","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Demuth Museum of Art","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Demuth Museum of Art","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Demuth Museum in Lancaster, Pennsylvania, United States, is a museum dedicated to the paintings of Charles Demuth (1883–1935) located in his former studio and home at 120 East King Street. The museum offers a rotating view of a permanent collection which includes 42 Charles Demuth originals as well as artists and works that present a Demuth connection in the areas of theme, technique and epoch. Two recent exhibitions have featured Demuth contemporaries Alfred H. Maurer and Lyonel Feininger. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}