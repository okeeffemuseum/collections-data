{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1432","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Modern Art Museum of Fort Worth","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":["Fort Worth Art Association","The Art Center, Fort Worth","The Fort Worth art Center"],"type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Modern Art Museum of Fort Worth","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Modern Art Museum of Fort Worth (widely referred to as The Modern) is an art museum of post-World War II art in Fort Worth, Texas with a collection of international modern and contemporary art. Founded in 1892, The Modern is located in the city's cultural district in a building designed by architect Tadao Ando which opened to the public in 2002. The museum is accredited by the American Alliance of Museums and holds a permanent collection with more than 3,000 works of art. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}