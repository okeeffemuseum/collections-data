{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1879","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Bryn Mawr College","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Bryn Mawr College","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":"Bryn Mawr College Art Museum","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Bryn Mawr College ( brin MAR, Welsh: [brɨn ˈmaur]) is a private women's liberal arts college in Bryn Mawr, Pennsylvania, United States. Founded as a Quaker institution in 1885, Bryn Mawr is one of the Seven Sister colleges, a group of historically women's colleges in the United States. The college has an enrollment of about 1,350 undergraduate students and 450 graduate students. It was one of the first women's colleges in the United States to offer graduate education through a PhD. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}