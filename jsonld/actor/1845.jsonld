{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1845","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Chase Collegiate School","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Chase Collegiate School","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":"Saint Margaret's School, Fulkerson Hall","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Chase Collegiate School was a nonsectarian private day school offering education for children from pre-kindergarten through grade 12. The school was on a 47-acre (190,000 m2) campus in Waterbury, Connecticut. Due to the COVID-19 pandemic, the school announced its closure on August 13, 2020. \n \nAs of 2015, the enrollment was 276 students: 61 Lower School (age 3 pre-kindergarten through 5th grade), 75 Middle School (6th through 8th grades), and 140 Upper School (high school). (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}