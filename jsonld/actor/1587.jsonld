{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1587","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Colorado Springs Fine Arts Center at Colorado College","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Colorado Springs Fine Arts Center at Colorado College","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Colorado Springs Fine Arts Center at Colorado College (FAC) is an arts center located just north of downtown Colorado Springs, Colorado. Located on the same city block are the American Numismatic Association and part of the campus of Colorado College. The center uses a thick red outline of a square as its logo. It has been listed on the National Register of Historic Places since July 3, 1986, under the former name Colorado Springs Fine Arts Center. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}