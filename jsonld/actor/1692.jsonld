{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1692","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Parkhurst","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Helen","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Helen Parkhurst","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Helen Parkhurst (March 8, 1886 – June 1, 1973) was an American educator, author, lecturer, the originator of the Dalton Plan, founder of the Dalton School and host of Child's World with Helen Parkhurst on ABC Television Network. Parkhurst took her cues from developmental psychologist Jean Piaget and education reformers such as John Dewey and Horace Mann, producing a progressive education philosophy emphasizing the development of the \"whole child\". (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}