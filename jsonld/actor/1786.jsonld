{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1786","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"David","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"David Oistrakh","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Oistrakh","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"David Fyodorovich Oistrakh (né Eustrach; 30 September [O.S. 17 September] 1908 – 24 October 1974), was a Soviet classical violinist, violist and conductor.Oistrakh collaborated with major orchestras and musicians from many parts of the world and was the dedicatee of numerous violin works, including both of Dmitri Shostakovich's violin concerti and the violin concerto by Aram Khachaturian. He is considered one of the preeminent violinists of the 20th century. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}