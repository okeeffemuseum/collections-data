{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1552","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Washington County Museum of Fine Arts","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Washington County Museum of Fine Arts","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Washington County Museum of Fine Arts (WCMFA) is an art museum located in Hagerstown, Maryland, United States. The building is located off Park Circle and serves as a centerpiece in Hagerstown City Park. The museum was donated in 1929, by Mr. and Mrs. William Singer, Jr. It was completed in 1931, and two wings were added in 1949. The museum provides residents and visitors with access to a nationally recognized permanent collection and a rotating schedule of exhibitions, musical concerts, lectures, films, art classes and special events for children and adults throughout the year. The collections include 19th \u0026 early 20th Century American Art, Old Masters, and Decorative art.Washington County Museum of Fine Arts has no entrance fee, and relies on public and private donations. The museum is accredited by the American Alliance of Museums (AAM). (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}