{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/625","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Coors Porcelain Company","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Coors Porcelain Company","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"CoorsTek, Inc. is a privately owned manufacturer of technical ceramics for aerospace, automotive, chemical, electronics, medical, metallurgical, oil and gas, semiconductor and many other industries.  CoorsTek headquarters and primary factories are located in Golden, Colorado, US.  The company is wholly owned by Keystone Holdings LLC, a trust of the Coors family.  John K. Coors, a great-grandson of founder and brewing magnate Adolph Coors, Sr., and the fifth and youngest son of longtime chairman and president Joseph Coors, retired as president and chairman in January 2020 after 22 years at the helm. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}