{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1935","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Greenville County Museum of Art","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Greenville County Museum of Art","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Greenville County Museum of Art (GCMA) is an art museum located in Greenville, South Carolina. Its collections focus mainly on American art, and its holdings include works by Andrew Wyeth,Jasper Johns (raised in South Carolina), William Henry Johnson, Andy Warhol, Romare Bearden, Jacob Lawrence, Alma Thomas, Helen Turner, Charles Wilson Peale, Eric Fischl, Marylyn Dintenfass, and Leonardo Drew. Southern American and South Carolina-based artists, such as Elizabeth O'Neill Verner, are also represented. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}