{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1338","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Max Weber","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Weber","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Max","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Max Weber (April 18, 1881 – October 4, 1961) was a Jewish-American painter and one of the first American Cubist painters who, in later life, turned to more figurative Jewish themes in his art.  He is best known today for Chinese Restaurant (1915), in the collection of the Whitney Museum of American Art, \"the finest canvas of his Cubist phase,\" in the words of art historian Avis Berman. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}