{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/2077","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"National Museum of Modern Art, Tokyo","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"National Museum of Modern Art, Tokyo","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The National Museum of Modern Art, Tokyo (東京国立近代美術館, Tōkyō Kokuritsu Kindai Bijutsukan), also known as MOMAT, is the foremost museum collecting and exhibiting modern Japanese art. The museum, in Chiyoda, Tokyo, Japan, is known for its collection of 20th-century art and includes Western-style and Nihonga artists. It has a branch, the National Crafts Museum, in the city of Kanazawa. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}