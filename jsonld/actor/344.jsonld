{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/344","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Herbert F. Johnson Museum of Art, Cornell University","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"","id":"https://data.okeeffemuseum.org/terms/local/"}],"content":"Herbert F. Johnson Museum of Art, Cornell University","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Herbert F. Johnson Museum of Art (\"The Johnson Museum\") is an art museum located on the northwest corner of the Arts Quad on the main campus of Cornell University in Ithaca, New York. Its collection includes two windows from Frank Lloyd Wright's Darwin D. Martin House, and more than 40,000 other works in the permanent collection, which spans six millennia and encompasses art from most world cultures. It was designed by architect I.M. Pei and is known for its distinctive concrete facade. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}