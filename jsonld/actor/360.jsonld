{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/360","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Minneapolis Institute of Arts","type":"Name"},{"classified_as":[{"_label":"subsidiary","id":"https://vocab.getty.edu/aat/300258351"}],"content":"Artmobile, Minneapolis Institute of Arts","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Minneapolis Institute of Arts","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Minneapolis Institute of Art (Mia) is an art museum located in Minneapolis, Minnesota, United States. Home to more than 100,000 works of art representing 5,000 years of world history, Mia is one of the largest art museums in the United States. Its permanent collection spans about 5,000 years and represents the world's diverse cultures across six continents. The museum has five curatorial areas: Arts of Global Africa, Global Contemporary Art, Asian Art, European Art, and Arts of the Americas. \nMore than a half-million people visit the museum each year, and a hundred thousand more are reached through the museum's Art Adventure program for elementary schoolchildren. The museum has a free general admission policy, as well as public programs, classes for children and adults, and interactive media programs. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}