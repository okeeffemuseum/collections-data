{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1024","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Ferragamo S.p.A.","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Ferragamo S.p.A.","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Salvatore Ferragamo (5 June 1898 – 7 August 1960) was an Italian shoe designer and the founder of luxury goods high-end retailer Salvatore Ferragamo S.p.A. An innovative shoe designer, Salvatore Ferragamo established a reputation in the 1930s. In addition to experimenting with materials including kangaroo, crocodile, and fish skin, Ferragamo drew on historic inspiration for his shoes. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}