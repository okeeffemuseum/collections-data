{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1106","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Schnurer","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Carolyn","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Carolyn Schnurer","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Carolyn Schnurer (born in New York City as Carolyn Goldsand on January 5, 1908 and died on March 15, 1998, in Palm Beach, Florida) was a fashion designer and a pioneer in American sportswear. Schnurer's designs have been featured in the magazines Vogue, Harper's Bazaar, and Life as well as in the Metropolitan Museum of Art. She has also received awards for her designs from Coty, The Cotton Council, International Sportswear, Miami Sportswear, and Boston Sportswear. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}