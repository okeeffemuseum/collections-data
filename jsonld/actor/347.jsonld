{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/347","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Worcester Art Museum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Worcester Art Museum","type":"Name"},{"classified_as":[{"_label":"acronym","id":"https://vocab.getty.edu/aat/300404659"}],"content":"WAM","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Worcester Art Museum houses over 38,000 works of art dating from antiquity to the present day and representing cultures from all over the world. The museum opened in 1898 in Worcester, Massachusetts. Its holdings include Roman mosaics, European and American art, and a major collection of Japanese prints. Since acquiring the John Woodman Higgins Armory Collection in 2013, it is also home to the second largest collection of arms and armor in the Americas. \nThe museum houses collected architecture (the Chapter House, 1932), acquired paintings by Monet (1910) and Gauguin (1921), and presented photography as an art form (1904). The Worcester Art Museum also has a conservation lab and year-round studio art program for adults and youth. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}