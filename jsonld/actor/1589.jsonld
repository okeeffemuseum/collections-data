{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1589","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Lyman Allyn Art Museum","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Lyman Allyn Art Museum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Lyman Allyn Art Museum is located in New London, Connecticut, and was founded in 1926 by Lyman Allyn's daughter Harriet Upson Allyn. Its collection includes European and non-Western art as well as American fine and decorative art, 17th-century European works on paper, 19th-century American paintings, and contemporary art. The museum also conducts educational programs. \n \nThe Deshon-Allyn House on the museum's campus is a Federal style house built in 1829 by Daniel Deshon, sold to Lyman Allyn, and occupied by various members of his family. It is listed on the National Register of Historic Places. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}