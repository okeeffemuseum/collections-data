{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1886","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"First State Bank","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"First State Bank","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The First State Bank in Edna, Kansas is a Classical Revival-style bank built in 1887.  It was listed on the National Register of Historic Places in 1982.  It is located at the southwest corner of Delaware and Main Streets in Edna. \n \nThe main block of the building is 40 by 27 feet (12.2 m × 8.2 m) in plan.  in 1912 a 16 by 27 feet (4.9 m × 8.2 m) one-story extension was added to the rear, and a 1958 modification added a 12 by 13 feet (3.7 m × 4.0 m) area. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}