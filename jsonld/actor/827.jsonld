{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/827","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Reynolda House Museum of American Art","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Reynolda House Museum of American Art","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Reynolda House Museum of American Art is an art museum located in Winston-Salem, North Carolina. Built in 1917 by Katharine Smith Reynolds and her husband R. J. Reynolds, founder of the R. J. Reynolds Tobacco Company, it displays a collection of American art ranging from the colonial period to the modern era. The house originally occupied the center of a 1,067-acre (4.32 km2) estate. It opened to the public as an institution dedicated to the arts and education in 1965, and as an art museum in 1967. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}