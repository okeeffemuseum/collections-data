{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Georgia O'Keeffe Museum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe Museum","type":"Name"},{"classified_as":[{"_label":"acronym","id":"https://vocab.getty.edu/aat/300404659"}],"content":"gokm","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Georgia O'Keeffe Museum is dedicated to the artistic legacy of Georgia O'Keeffe, her life, American modernism, and public engagement. It opened on July 17, 1997, eleven years after the artist's death. It comprises multiple sites in two locations: Santa Fe, New Mexico, and Abiquiu, New Mexico. In addition to the founding Georgia O'Keeffe Museum (also called the Museum Galleries) in Santa Fe, the O'Keeffe includes: the Library and Archive within its research center at the historic A.M. Bergere house; the Education Annex for youth and public programming; Georgia O'Keeffe's historic Abiquiu Home and Studio; the O'Keeffe Welcome Center in Abiquiu; and Museum Stores in both Santa Fe and Abiquiu. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}