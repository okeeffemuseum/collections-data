{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/2107","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Michael S. Engl Family Foundation Library and Archive","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Michael S. Engl Family Foundation Library and Archive","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Michael S. Engl Family Foundation Library and Archive at the Georgia O'Keeffe Museum supports the Museum’s exhibitions, collections, and activities through research services and resources with an emphasis on studies of Georgia O’Keeffe and her contemporaries, related regional histories, and Modernism. A variety of materials are made accessible to the public and the Museum’s staff including: exhibition catalogs, scholarly publications, vertical (subject) files, criticism files, pamphlet files, correspondence, photographs, ephemera and audiovisual material.","type":"LinguisticObject"}],"representation":[],"type":"Actor"}