{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/332","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Norton Museum of Art","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Norton Museum of Art","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":"Norton Gallery and School of Art","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Norton Museum of Art is an art museum in West Palm Beach, Florida. The museum has a collection that includes over 8,200 works, with a concentration in European, American, and Chinese art as well as in contemporary art and photography. In 2003, it overtook the John and Mable Ringling Museum of Art, in Sarasota, to become the largest museum in Florida. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}