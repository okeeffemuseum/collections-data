{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1664","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"American Friends of the Hebrew University","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"American Friends of the Hebrew University","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"American Friends of the Hebrew University (AFHU) is a non-profit organization headquartered in New York City which promotes and supports the Hebrew University of Jerusalem. American businessman and philanthropist Felix M. Warburg founded AFHU in June 1925 and served as its first chairman. The organization was originally named the \"American Advisory Committee\" but changed its name to what it is currently known as in 1931.In December 2008, AFHU launched its inaugural \"Einstein Award\" and gala. Microsoft founder and chairman Bill Gates was the first recipient. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}