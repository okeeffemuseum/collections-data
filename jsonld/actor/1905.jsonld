{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1905","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Staatliche Kunsthalle","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Staatliche Kunsthalle","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Staatliche Kunsthalle (State Art Gallery) is an fine art museum in Karlsruhe, Germany. Its collection consists of works by mainly German, French, Flemish and Dutch masters from the past eight centuries. The museum was conceived in the early 19th century by Heinrich Hübsch as a “Gesamtkunstwerk” combining architecture, painting and sculpture to house the collection of the Grand Duke of Baden. \n \nThe Kunsthalle Karlsruhe was one of the first museum buildings in Germany and is one of the very few to have largely retained its original design. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}