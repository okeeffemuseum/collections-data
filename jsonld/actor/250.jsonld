{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/250","identified_by":[{"classified_as":[{"_label":"maiden name","id":"https://vocab.getty.edu/aat/300404682"}],"content":"Anita Natalie O'Keeffe","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Anita O'Keeffe Young","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Anita O'Keeffe","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Young","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Sister of Georgia O'Keeffe. Married Robert Young who attained a substantial fortune after 1929 Crash. Had homes in NYC, Newport, R.I. and Palm Beach, Florida. Daughter Eleanor died in plane crash in 1941. Robert committed suicide in 1958. She and sister Georgia exchanged frequent visits.","type":"LinguisticObject"}],"representation":[],"type":"Actor"}