{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1722","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Hessisches Landesmuseum","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Hessisches Landesmuseum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Hessisches Landesmuseum Darmstadt (HLMD) is a large multidisciplinary museum in Darmstadt, Germany. The museum exhibits Rembrandt, Beuys, a primeval horse and a mastodon under the slogan \"The whole world under one roof\". As one of the oldest public museums in Germany, it has c. 80,000 visitors every year and a collection size of 1.35 million objects. Since 2019, Martin Faass has been director of the museum. It is one of the three Hessian State museums, in addition to the museums in Kassel and Wiesbaden. Similar institutions in Europe are the Universalmuseum Joanneum in Graz and the National Museum of Scotland in Edinburgh. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}