{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1899","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Museum of New Zealand","type":"Name"},{"classified_as":[{"_label":"former name","id":"https://vocab.getty.edu/aat/300435719"}],"content":"National Art Gallery","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Museum of New Zealand","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Museum of New Zealand Te Papa Tongarewa is New Zealand's national museum and is located in Wellington.  Usually known as Te Papa (Māori for 'the treasure box'), it opened in 1998 after the merging of the National Museum of New Zealand and the National Art Gallery. An average of more than 1.1 million people visit every year, making it the 58th-most-visited art gallery in the world in 2023. Te Papa operates under a bicultural philosophy, and emphasises the living stories behind its cultural treasures. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}