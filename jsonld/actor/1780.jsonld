{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1780","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Nikhilananda","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Swami","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Swami Nikhilananda","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Swami Nikhilananda (1895–1973), born Dinesh Chandra Das Gupta was a direct disciple of Sri Sarada Devi. In 1933, he founded the Ramakrishna-Vivekananda Center of New York, a branch of Ramakrishna Mission, and remained its head until his death in 1973. An accomplished writer and thinker, Nikhilananda's greatest contribution was the translation of Sri Sri Ramakrishna Kathamrita from Bengali into English, published under the title The Gospel of Sri Ramakrishna (1942). (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}