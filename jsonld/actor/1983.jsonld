{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1983","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"","id":"https://data.okeeffemuseum.org/terms/local/"}],"content":"University of Mississippi Museum","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"University of Mississippi Museum","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The University of Mississippi Museum and Historic Houses is a museum and two historic houses owned and operated by the University of Mississippi in Oxford, Mississippi. The museum is designed to appeal to both a popular and scholarly audience, with a collection that emphasizes objects of regional interest. In addition to collections of Southern folk art, Greek and Roman antiquities, 19th century scientific instruments, and American fine art. Part of the museum complex is Rowan Oak, a historic literary legacy that was once the home of William Faulkner, Nobel and Pulitzer Prize-winning author. Rowan Oak was renovated and reopened to the public in 2001 and continues to draw international visitors each year. The museum also owns the Walton-Young Historic House – once home to critic and satirist Stark Young.  (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}