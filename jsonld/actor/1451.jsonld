{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1451","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Pennsylvania Academy of the Fine Arts (PAFA)","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Pennsylvania Academy of the Fine Arts (PAFA)","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Pennsylvania Academy of the Fine Arts (PAFA) is a museum and private art school in Philadelphia, Pennsylvania. It was founded in 1805 and is the first and oldest art museum and art school in the United States.The academy's museum is internationally known for its collections of 19th- and 20th-century American paintings, sculptures, and works on paper. Its archives house important materials for the study of American art history, museums, and art training.  It offers a Bachelor of Fine Arts, Master of Fine Arts, certificate programs, and continuing education. (Sourced from Wikipedia May 2023)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}