{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1519","identified_by":[{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Portland Art Museum","type":"Name"},{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Portland Art Museum","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The Portland Art Museum (PAM) is an art museum  in downtown Portland, Oregon, United States. The Portland Art Museum has 240,000 square feet (22,000 m2), with more than 112,000 square feet (10,400 m2) of gallery space.  The museum’s permanent collection has over 42,000 works of art. PAM features a center for Native American art, a center for Northwest art, a center for modern and contemporary art, permanent exhibitions of Asian art, and an outdoor public sculpture garden. The Northwest Film Center is also a component of Portland Art Museum. \nThe museum is accredited by the American Alliance of Museums, with accreditation through 2024. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}