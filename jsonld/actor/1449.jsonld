{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1449","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"New Britain Museum of American Art","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"New Britain Museum of American Art","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"The New Britain Museum of American Art is an art museum in New Britain, Connecticut. Founded in 1903, it is the first museum in the country dedicated to American art. \n \nA total of 72,000 visits were made to the museum in the year ending June 30, 2009, and another 16,000 visits were made to the museum's satellite gallery at TheatreWorks in Hartford, Connecticut. \n \nWalnut Hill Park, designed by Frederick Law Olmsted, is next to the museum. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}