{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/actor/1382","identified_by":[{"classified_as":[{"_label":"first_name","id":"https://data.okeeffemuseum.org/terms/local/first_name"}],"content":"Wanda","type":"Name"},{"classified_as":[{"_label":"last_name","id":"https://data.okeeffemuseum.org/terms/local/last_name"}],"content":"Corn","type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Wanda Corn","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"biography statement","id":"https://vocab.getty.edu/aat/300435422"}],"content":"Wanda M. Corn is an American art and cultural historian. \n \nCorn is a scholar of art and photography from the late 19th to mid-20th centuries. She is the Robert and Ruth Halperin Professor emerita of art history at Stanford University. She held the professorship for eight years before retiring from the university in March 2017. Over her career as an art professor at Stanford she brought John D. Rockefeller's personal collection to the Fine Arts Museums of San Francisco, which included a \"a body of 110 paintings described as the museums’ “single most important gift of art.\" She served as acting director of the Stanford Art Museum now known as the Iris \u0026 B. Gerald Cantor Center for Visual Arts. Prior to her position at Stanford she held the Samuel H. Kress Professorship at the Center for Advanced Study in the Visual Arts, at the National Gallery of Art from 2006 to 2007. (Source: Wikipedia, 2025)","type":"LinguisticObject"}],"representation":[],"type":"Actor"}