{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11196","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PA3855.E5 M27","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11196","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Aesop: five centuries of illustrated fables ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Metropolitan Museum of Art (The Met)","id":"actor/metropolitan-museum-of-art","type":"Actor"},{"_label":"New York Graphic Society","id":"actor/new-york-graphic-society","type":"Actor"}],"timespan":{"_label":"1964","begin_of_the_begin":"1964-01-01T00:00:00Z","end_of_the_end":"1964-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found between pp. 84-[85] : Blank postcard depicting The Yamatoya Nippon Nobility, Nikkatsu Arcade, Hibiya Tokyo, undated.\nGeorgia O'Keeffe Personal Library.\nBinding by J. F. Tapley Company.\nFifteen thousand copies were printed, second printing produced ten thousand copies.\nIncludes translations by Marianne Moore.\nOffset lithography and dust jacket by The Meriden Gravure Company.\nPrinted by the Spiral Press.\nText printed in red and black ink.\nThe illustrations are facsimiles of the original prints in the collection of the Metropolitan Museum of Art.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition ; dust jacket : fair condition.|SColl abq : per original inventory : Claudia's Room.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}