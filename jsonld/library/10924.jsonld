{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/10924","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"KJV130.B33 B3313 1964","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"10924","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The defense of Gracchus Babeuf before the High Court of Vendôme  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Babeuf, Gracchus,","id":"actor/babeuf-gracchus","type":"Actor"},{"_label":"Gehenna Press","id":"actor/gehenna-press","type":"Actor"}],"timespan":{"_label":"1964","begin_of_the_begin":"1964-01-01T00:00:00Z","end_of_the_end":"1964-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition ; slipcase : good condition ; pages uncut.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O'Keeffe Personal Library.\nNo. 75 of 300.\nIssued in quires, in a case.\nManifeste des Égaux, by Sylvain Marâechal (English translation): p. 61-[64].\nThree hundred copies of this book were printed at the Gehenna Press in Northampton, Mass., the work finished during March 1964. The type throughout is Baskerville. The paper is Nideggen made in Germany. Harold McGrath was the pressman. The suite of etchings were printed by Emiliano Sorini in New York--Colophon.\nTranslated selections from Babeuf's Défense générale.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}