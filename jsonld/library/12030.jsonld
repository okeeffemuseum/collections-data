{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12030","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12030","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Tenshin to gendai Nihonga ten ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Tokyo Central Museum of Art","id":"actor/tokyo-central-museum-of-art","type":"Actor"}],"timespan":{"_label":"1972","begin_of_the_begin":"1972-01-01T00:00:00Z","end_of_the_end":"1972-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Cover depicts painting of bamboo.\nExhibition catalog, Nihonga paintings by many artists, dated 1891 to 1971, themed on the legacy of Tenshin Okakura.\nCatalogue from an exhibit held at the Tokyo Central Museum of Art from January 7th through January 30th, 1972. Sponsored by the Tenshin and Contemporary Nihonga Committee and the Asahi Newspaper.\nSource of translations and data : Absolute Translations, 2019.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}