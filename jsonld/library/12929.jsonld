{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12929","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12929","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"NE2052.5.P5 M4 1969","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Melville on Piranesi. ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Melville, Herman,","id":"actor/melville-herman","type":"Actor"},{"_label":"Gehenna Press","id":"actor/gehenna-press","type":"Actor"}],"timespan":{"_label":"1969","begin_of_the_begin":"1969-01-01T00:00:00Z","end_of_the_end":"1969-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found inside : Signed best wishes note from The Meriden Gravure Company ; New Year greeting from The Gehenna Press, 1969 ; Handwritten note by unknown : Gehenna Press / Northampton Mass ; Pamphlet : Four New Gehenna Press Books, 1971 ; Gehenna Press advertistement for The Hippolytos of Euripedes.\nEphemera : copies originally housed together in cardboard folio.\nGeorgia O'Keeffe Personal Library.\nExtract from Clarel.\nReproduction of Piranesi print mounted on p. [2].\nTwelve hundred copies of this broadside were printed at the Gehenna Press \u0026 the Meriden Gravure Company in December 1969 for the one hundred \u0026 fiftieth anniversary of the birth of Herman Melville--Page [4].","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copies : good condition.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}