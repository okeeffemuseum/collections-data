{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm03435438","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm03435438 ","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"TR1 .U7","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"U.S. camera. ","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"_label":"","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"grl copies : fair condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Editor: 1935-\u003c1964\u003e, T.J. Maloney.\nPublisher varies: \u003c1935\u003e-1939, William Morrow \u0026 Company; 1940, Random House; 1941-1945, Duell, Sloan \u0026 Pearce; 1946-1948, U.S. Camera Publishers; 1949-\u003c1964\u003e, U.S. Camera Publishing Corporation.\nSome volumes have cover title: U.S. camera annual.\nVols. for 1944-45 have also a distinctive title: The U.S.A. at war.\nVols. for 1947-48 have subtitle: 1. Great news pictures. 2. Finest photographs.\nVol. for 1946 called \"Victory volume,\" 1950 called \"International edition,\" 1951 called \"American-international.\"\nVol. for 1941 in 2 v.: v. 1. America; v. 2. The year's photography.\nFrom Georgia O'Keeffe's Ghost Ranch library.\nPage marker found between pp. 178-179.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}