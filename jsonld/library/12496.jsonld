{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12496","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12496","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"DS785 .P18 1949","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Peaks and lamas  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Pallis, Marco,","id":"actor/pallis-marco","type":"Actor"},{"_label":"Alfred A. Knopf","id":"actor/a-a-knopf","type":"Actor"}],"timespan":{"_label":"1949","begin_of_the_begin":"1949-01-01T00:00:00Z","end_of_the_end":"1949-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition ; dust jacket : good condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found between pp. 50-51 : flat origami.\nEphemera found inside front cover : Handwritten letters from Lucile C. Oren to Georgia O'Keeffe : 1 page letter (February 1978) explains that the enclosed 7 pages letter and envelope (November 20, 1977) addressed to Georgia O'Keeffe were from a letter from Lucile that was returned to sender.\nEphemera found inside front cover : Red heart printed on rice paper with inscription : Happy Valentines [sic] Day, / Miss O'Keeffe! / from Margaret.\nGeorgia O'Keeffe Personal Library.\nPage marker found between pp. 128-129 ; pp. 348-349 ; before p. 331.\nIncludes index.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815104/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815104"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}