{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12803","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PR5774 .C6 1915","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12803","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The country of the blind. ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Wells, H. G.","id":"actor/wells-h-g","type":"Actor"},{"_label":"Privately printed [by Mitchell Kennerley] Christmas","id":"actor/privately-printed-by-mitchell-kennerley-christmas","type":"Actor"}],"timespan":{"_label":"1915","begin_of_the_begin":"1915-01-01T00:00:00Z","end_of_the_end":"1915-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition ; dust jacket : fair condition.|SColl abq : Embossed stamp on front loose endpaper : Georgia O'Keeffe / Abiquiu, New Mexico.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera : Originally housed in mailing envelope addressed to Alfred Stieglitz with printed note : For delivery Christmas morning.\nEphemera found in front of t.p. : Printed slip [compliments card] : From Mitchell Kennerley / Christmas 1915.\nGeorgia O'Keeffe Personal Library.\nReprint of title story of a collection published in 1911. See G.H. Wells, 41a, note.\nThe illus. is from a photograph by Alvin Langdon Coburn.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815303/full/full/0/default.jpg","ty