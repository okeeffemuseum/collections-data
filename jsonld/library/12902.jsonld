{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12902","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12902","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"DS821 .B572 1961","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Japan  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Bischof, Werner,","id":"actor/bischof-werner","type":"Actor"},{"_label":"Bantam Books","id":"actor/bantam-books","type":"Actor"}],"timespan":{"_label":"1961","begin_of_the_begin":"1961-01-01T00:00:00Z","end_of_the_end":"1961-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found in front of pl. 74 : Postcard from Marjorie and [Bob?] Griffing to [Georgia] O'Keefe [sic], undated : refers to and invitation to Edith's [Halpert] gallery, meeting in Honolulu and re-hanging the museum ; front of postcard depicts Kichijo-ten.\nEphemera found in front of pl. 88 : Tag for Georgia O'Keeffe's Only One, 1959 handwritten in Enlish and Japanese ; typewritten note that refers to the tag being from an exhibition at the Bridgestone Gallery in Tokyo, undated.\nGeorgia O'Keeffe Personal Library.\nGDQ 2--Spine.\nSecond sequence of paging numbered 110; recto side unnumbered, verso side unnumbered, followed by 3 pages of text.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}