{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11107","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11107","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PT2026.F2 T39 1912","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Faust: a tragedy ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Goethe, Johann Wolfgang von,","id":"actor/goethe-johann-wolfgang-von","type":"Actor"},{"_label":"Houghton Mifflin Company","id":"actor/houghton-mifflin","type":"Actor"}],"timespan":{"_label":"1912-1913","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera : four-leaf clover found between : v. 1, pp. 158-159 ; v. 2, pp. 28-29 ; 194-195 ; 264-265.\nEphemera found between v. 1, pp. 22-23 : handwritten note from Alfred Stieglitz : 1:45 / Gone to get / a cup of coffee / Then back / next door / A.\nEphemera found between v. 2, pp. 344-345 : sketch by Georgia O'Keeffe ; transferred to the fine art collection : see registrar for accession no.\nGeorgia O'Keeffe Personal Library.\nPage marker found between v. 1, pp. 18-19.\nEach volume has separate t.p.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : fair condition.|SColl abq :  Pages dog-eared : v. 1, p. 352 ; v. 2, p. 203.|SColl abq : Inscription on front loose endpaper from Alfred Stieglitz to Georgia O'Keeffe, 1916 : I have lived - When I / was nine I discovered Faust. / - It gave me quiet then. - I knew not why. - But it gave me quiet. - And I / have lived since then - much / and hard - and in consequence / suffered so that I could not / suffer any more. - Faust / quieted me in such despairing / moments - always - / and as I grew it seemed to / also grow. - It is a Friend. / - Like the Lake. - / - To One who, without / knowing, has given me much at / a time when I needed Faust \u0026 / Lake. - / 1916..","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814137/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814137"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814158/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814158"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814174/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/814174"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"applicat