{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12666","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12666","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PS3537.T323 H3","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Have they attacked Mary. He giggled. (A political caricature),* ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Gertrude Stein","id":"actor/stein-gertrude","type":"Actor"},{"_label":"H.F. Temple, printer","id":"actor/h-f-temple-printer","type":"Actor"}],"timespan":{"_label":"1917","begin_of_the_begin":"1917-01-01T00:00:00Z","end_of_the_end":"1917-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"*This poem first appeared in the Vanity fair for June, 1917. Owing to lack of space, thirty-five lines were omitted. These have now been restored and the work is intact. It has been referred to as a 'portrait' of Henry McBride, the art critic.\nLimited to two hundred copies--Title page verso.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/816746/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/816746"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject