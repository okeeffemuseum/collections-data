{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/6028","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"6028","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The Female of the species achieves a new deadliness: women painters of America whose work exhibits distinctiveness of style and marked individuality.","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Vanity Fair","id":"actor/vanity-fair","type":"Actor"}],"timespan":{"_label":"July 1922","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Includes a photo of Georgia O'Keeffe by Alfred Stieglitz.\nIncludes brief references to five other women artists: Marguerite Zorach, Ilonka Karasz, Florence Cane, Lydia Gibson, and Eyre De Lanux.\nIncludes typewritten copy of text pertaining to Georgia O'Keeffe.\nPhotocopy of an article from Vanity Fair, July 1922, p. 50.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}