{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm02150649","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PK3633.H3 T5","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm02150649 ","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The transmigration of the seven Brahmans ; a translation from the Harivansa of Langlois ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"W.E. Rudge","id":"actor/w-e-rudge","type":"Actor"}],"timespan":{"_label":"1932","begin_of_the_begin":"1932-01-01T00:00:00Z","end_of_the_end":"1932-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"\"This the first edition consists of 1200 copies, 200 of which are printed on handmade paper and numbered.\"\nThe translation is from S.A. Langlois' French translation of the original Sanskrit, published in Paris, 1834, and entitled, \"Harivansa; ou, Histoire de la famille de Hari, ouvrage formant un appendice du Mahabharata\". The thoreau translation is from volume 1, p. 100-110. cf. p. [15]","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}