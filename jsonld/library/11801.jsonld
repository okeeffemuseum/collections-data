{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11801","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11801","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"TR646.C46 C46 P5","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Photograph 1: a photographic competition for amateur and professional photographers ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Cincinnati Art Club?","id":"actor/cincinnati-art-club","type":"Actor"}],"timespan":{"_label":"1972","begin_of_the_begin":"1972-01-01T00:00:00Z","end_of_the_end":"1972-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition.|SColl abq : Inscription on p. [1] from Lee D. Witkin to Georgia O'Keeffe, June 10, 1972 : June 10, 1972 / For Georgia O'Keeffe, who / has been very nice to us / this afternoon. Many thanks.  Lee D. Witkin.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O'Keeffe Personal Library.\nDuring this competition an Invitational Exhibition of photographs, selected by Mr. Lee D. Witkin ... was on display at the Cincinnati Art Club. This book is a selection of prints from the Invitational Exhibit.\nSColl abq : per inventory : Sitting Room.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}