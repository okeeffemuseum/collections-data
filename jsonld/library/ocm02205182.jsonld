{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm02205182","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm02205182 ","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"ND553.C33 M42 1927","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Cezanne  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Meier-Graefe, Julius,","id":"actor/meier-graefe-julius","type":"Actor"}],"timespan":{"_label":"","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"\"The edition is limited to 650 numbered copies. Of these, numbers 1 to 50 are printed on hand-made paper, have as frontispiece a facsimile reproduction in colour of a watercolour by Cezanne, and are signed by the author and the translator. This copy is no. ...\"--Half title verso.\n\"My translation is based upon the fifth and last edition of \"Paul Cezanne,\" specially revised and augmented by the author for purposes of the present issue.\"--Translator's preface.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}