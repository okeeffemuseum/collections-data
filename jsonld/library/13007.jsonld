{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/13007","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"13007","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"N6490 .D7 1926","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Modern art  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Dreier, Katherine S.","id":"actor/dreier-katherine-s","type":"Actor"},{"_label":"Societe Anonyme","id":"actor/societe-anonyme","type":"Actor"}],"timespan":{"_label":"1926","begin_of_the_begin":"1926-01-01T00:00:00Z","end_of_the_end":"1926-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : fair condition.|SColl abq : Inscription on front loose endpaper from Katherine S. Dreier and Marcel Duchamp to Georgia O'Keeffe, March 1927 : Greetings / To Georgia O'Keeffe / from Katherine S. Dreier Pres. / Marcel Duchamp Sec. / Société Anonyme Inc. / New York - March 1927.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O'Keeffe Personal Library.\nPage marker found between pp. 90-91.\nIncludes biographical and critical material on the artists represented.\nIncludes work by Charles Demuth, Arthur G. Dove, Marsden Hartley, John Marin, Georgia O'Keeffe, Alfred Stieglitz, Abraham Walkowitz, and Max Weber, among others.\nOn cover : International Exhibition of Modern Art arranged by the Société Anonyme for the Brooklyn Museum, November-December 1926.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}