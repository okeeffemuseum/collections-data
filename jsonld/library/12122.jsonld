{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12122","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"NE1310 .C43","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12122","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The Clarence Buckingham collection of Japanese prints. ","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"_label":"1955-\u003c1965\u003e","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O'Keeffe Personal Library.\nPage marker found between pp. 121-122.\nThis edition is limited to 500 numbered catalogues designed by Suzette Morton Zurcher of the Art Institute of Chicago.  The type was composed and printed by The Anthoensen Press of Portland, Maine.  Color plates and collotype illustrations were made by The Meridan Gravure Company, Meridan, Connecticut. The binding was done by John W. Marchi of Portland, Maine. Number 91 [vol. 1]. -- Colophon.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : fair condition ; dust jacket : good condition.|SColl abq : Embossed stamp in front of book : Georgia O'Keeffe / Abiquiu, New Mexico.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}