{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm06557867","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"TR675 .C35","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm06557867 ","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The decisive moment  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Cartier-Bresson, Henri,","id":"actor/cartier-bresson-henri","type":"Actor"}],"timespan":{"_label":"","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"\"This book, with a cover designed and executed especially for it by Henri Matisse, is a selection of 126 photographs from the work of Henri Cartier-Bresson. The French edition by Verve (Images a la sauvette) and the American edition ... were conceived and composed by Teriade with the collaboration of Marguerite Lang. The engraving and printing is the work of the master printers Draeger frères of Paris. It was completed the 22nd of July, 1952\"--Colophon.\n\"Captions\" (duplicates of those in text) : 12 unnumbered pages laid in.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}