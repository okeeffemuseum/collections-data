{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/5754","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"5754","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"TR680 .K287 1968","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Portraits by Karsh: [exhibition] Museum of Fine Arts, Boston, April 19-June 4, 1968.","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Yousuf Karsh","id":"actor/karsh-yousuf","type":"Actor"},{"_label":"Printed by the Meriden Gravure Co.","id":"actor/printed-by-the-meriden-gravure-co","type":"Actor"}],"timespan":{"_label":"1968","begin_of_the_begin":"1968-01-01T00:00:00Z","end_of_the_end":"1968-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"From Georgia O’Keeffe’s Ghost Ranch library.\nMoved from general Special Collections to Georgia O'Keeffe's Ghost Ranch Library 2015.\nIncludes portraits of Brigitte Bardot, Pablo Casals, Sir Winston Churchill, Jean Cocteau, Robert Frost, Alberto Giacometti, Ernest Hemingway, Helen Keller, John Fitzgerald Kennedy, Nikita Sergeyevich Khrushchev, Jacques Lipchitz, Joan Miro, Georgia O'Keeffe, Pablo Picasso, and Pope John XXIII.\nSelections from an exhibition held at the Museum of Fine Arts, Boston, April 19-June 4, 1968.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"grl copy : good condition.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}