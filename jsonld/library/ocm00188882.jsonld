{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm00188882","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm00188882 ","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"TR6 .N55 1938","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Photography: a short critical history ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Newhall, Beaumont,","id":"actor/newhall-beaumont","type":"Actor"},{"_label":"Museum of Modern Art (MoMA)","id":"actor/the-museum-of-modern-art","type":"Actor"}],"timespan":{"_label":"1938","begin_of_the_begin":"1938-01-01T00:00:00Z","end_of_the_end":"1938-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"\"Three thousand copies of this revised edition were printed for the trustees of the Museum of modern art by the Spiral press, New York.\"\n\"In the spring of 1937 the Museum of modern art held an exhibition 'Photography 1839-1937' ... The introduction and plates to the catalog of that exhibition form the body of this book. The text has been revised in part, and considerable hitherto uncollected data has been included in the outlines forming the Biographical index, which takes the place of the now obsolete catalog lists of the original publication.\"--Preface.\n\"Second edition, revised and emended, July 1938.\"","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}