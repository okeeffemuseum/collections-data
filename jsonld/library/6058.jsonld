{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/6058","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"6058","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Seven American artists sponsored by Stieglitz    ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"The World","id":"actor/the-world","type":"Actor"}],"timespan":{"_label":"1925","begin_of_the_begin":"1925-01-01T00:00:00Z","end_of_the_end":"1925-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Includes information about  an exhibition organized by Stieglitz at Anderson Galleries that featured the works of Arthur G. Dove, Marsden Hartley, John Marin, Charles Demuth, Paul Strand, Georgia O'Keeffe and Alfred Stieglitz.\nPhotocopy of an article from The World, March 15, 1925, p. 5m.\nReference is made to Autumn Trees; Autumn Trees - The Maples, 1924 (CR 474) and Autumn Trees - The White Birch, 1924 (CR 475) by Georgia O'Keeffe.\nReference is made to Leaf Motif(s) No. 1 (CR 466) and No. 2 (CR 467), 1924, by Georgia O'Keeffe.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}