{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11994","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PS3545.I544 P3","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11994","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Paterson ...  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Williams, William Carlos,","id":"actor/williams-william-carlos","type":"Actor"},{"_label":"New directions","id":"actor/new-directions","type":"Actor"}],"timespan":{"_label":"1946-1958","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition ; dust jacket : good condition.|SColl abq : Embossed stamp on front loose endpaper : Georgia O'Keeffe / Abiquiu, New Mexico.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found between pp. [20-21] : Compliments card from W.C. Williams to Alfred Stieglitz, undated.\nGeorgia O'Keeffe Personal Library.\nIn verse.\nOf this first edition of Paterson: Book 1, one thousand copies have been printed for New Directions by the Van Vechten Press in Metuchen, New Jersey. The types used are Original English Caslon and Linotype Caslon Old Face ... The printing was completed in January, 1946--Colophon, book 1.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}