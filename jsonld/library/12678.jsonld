{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/12678","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"PR6023.A93 L2 1928","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"12678","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Lady Chatterley's lover  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Lawrence, D. H.","id":"actor/lawrence-d-h","type":"Actor"},{"_label":"Privately printed","id":"actor/privately-printed","type":"Actor"}],"timespan":{"_label":"1928","begin_of_the_begin":"1928-01-01T00:00:00Z","end_of_the_end":"1928-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : fair condition ; slipcase : good condition.|SColl abq : Signature by D.H. Lawrence.|SColl abq : This edition is limited to One thousand copies. No. 389, signed--2nd preliminary page.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found in front of t.p. : Handwritten note from G.M. Orioli to unknown, undated with the Lawrence phoenix on verso : The other copy will be sent / to you with next mail / or when I hear from you / Best regards / yours sincerely / G.M. Orioli.\nGeorgia O'Keeffe Personal Library.\nFirst edition--Roberts.\nPrinter statement from title page verso.\nPublished July 1928 ... in Britain and ... in America; the first printing consisted of 1,000 copies.--Roberts.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815250/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815250"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815264/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815264"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815245/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815245"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/815255/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/