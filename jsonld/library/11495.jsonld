{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11495","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"F788 .P886 1961","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11495","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The exploration of the Colorado River  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Powell, John Wesley,","id":"actor/powell-john-wesley","type":"Actor"},{"_label":"Anchor Books","id":"actor/anchor-books","type":"Actor"}],"timespan":{"_label":"1961","begin_of_the_begin":"1961-01-01T00:00:00Z","end_of_the_end":"1961-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O'Keeffe Personal Library.\nFirst published in 1875 as a report to the Smithsonian Institution [under title]: Exploration of the Colorado River of the west and its tributaries. The volume contained both narrative and geological accounts of the region. The present edition reprints the narrative account.\nIncludes index.\nPublished in co-operation with the American Museum of Natural History.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}