{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/7671","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"NA1088.M65 N4","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"7671","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Mies van der Rohe  ","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"_label":"1947","begin_of_the_begin":"1947-01-01T00:00:00Z","end_of_the_end":"1947-01-01T00:00:00Z","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found between pp. 100-101 : Article Mies van der Rohe from Architectural Record, September 1947 with annotation on front : by Philip C. Johnson.\nEphemera found between pp. 94-95 : Typed sheet of paper by unknown : refers to Mark Tobey and Mies van der Rohe.\nFrom Georgia O'Keeffe's Ghost Ranch library.\nCorrection slip inserted between p. 142-143.\nPublished on the occasion of an exhibition of the architecture of Mies Van der Rohe held at the Museum of Modern Art, September 16-November 23, 1947.\nTwelve thousand copes of this book were printed in September 1947 for the trustees of the Museum of Modern Art by the Plantin Press, New York.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"grl copy : good condition.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}