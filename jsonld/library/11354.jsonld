{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11354","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"NX1 . S16","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11354","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"S.M.S. ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Letter Edged in Black Press","id":"actor/letter-edged-in-black-press","type":"Actor"}],"timespan":{"_label":"c1968","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : fair condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ephemera found inside : Typed form letter requsting contribution to the publication, undated.\nEphemera found inside : Typed letter from [William] Wm. N. Copley to Georgia [O'Keeffe], March 6, 1968, letter paper clipped to a flyer about the publication.\nGeorgia O'Keeffe Personal Library.\nEach no. consists of miscellaneous loose items, issued in portfolio; title from cover flap of portfolio.\nEdited by William Copley.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}