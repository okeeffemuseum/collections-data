{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/ocm03306410","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"ocm03306410 ","type":"Identifier"},{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"AP2 .I7818","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Intro. ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Intro","id":"actor/intro","type":"Actor"}],"timespan":{"_label":"1950-1953","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"abq copy : good condition.|Embossed stamp on front loose endpaper : Georgia O'Keeffe / Abiquiu, New Mexico.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Vol. 1, no. 1 lacks subtitle.\nVol. 1-2, no. 1, have subtitle: A quarterly of literature and art.\nGeorgia O'Keeffe Personal Library.\nEphemera : originally housed in manila file folder with annotation by Georgia O'Keeffe : \"Almanac 43 - Poetry 22 Little Review 26 Felix Weingartner / On Conducting\".\nEphemera found inside back cover : announcement and order form for Intro Magazine v. 2, no. 1.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}