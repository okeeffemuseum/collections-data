{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/11238","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"N2 .D4","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"11238","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Derriere le miroir. ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Aime Maeght","id":"actor/aime-maeght","type":"Actor"}],"timespan":{"_label":"1946-1982","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"scoll copies : good condition.|grl copies : good condition.","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Issued as portfolios.\nTitle from cover.\nFrom Georgia O'Keeffe's Ghost Ranch library.\nEphemera found inside 3rd plate : invitation in French to Joan Miro exhibition on June 19, 1953.\nEphemera found between pp. [3-4] : Typed letter from P. Adrien Maeght to Madame [Georgia O'Keeffe], May 17, 1954.\nEphemera found inside front cover : Business reply card : Derriere Le Miroir.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}