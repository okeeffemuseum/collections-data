{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/library/3779","identified_by":[{"classified_as":[{"_label":"call number","id":"https://vocab.getty.edu/aat/300311706"}],"content":"N6537.O39 S4 1988","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"3779","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe  ","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/okeeffe-georgia","type":"Actor"},{"_label":"Seibu Museum of Art","id":"actor/seibu-museum-of-art","type":"Actor"}],"timespan":{"_label":"c1988","type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"From Georgia O'Keeffe's Ghost Ranch library.\nCatalog of an exhibition held in Tokyo, 12 August-30 August 1988, Otsu, 15 September-10 October 1988.\nColophon title in English: Catalogue of Georgia O'Keefe exhibition in Japan.\nColophon title in Japanese: Amerika nijū seiki bijutsu no suisei, Jōjia Okīfu ten zuroku.\nGerald Peters Gallery--P. [4] of cover.\nIn English and Japanese.\nPublication date is after O'Keeffe's death in 1986. Book is likely not part of the original Ghost Ranch library.\nSpine title: Jyōjia Okīfu ten.","type":"LinguisticObject"},{"classified_as":[{"_label":"inscription statement","id":"https://vocab.getty.edu/aat/300435414"}],"content":"grl copy : good condition.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}