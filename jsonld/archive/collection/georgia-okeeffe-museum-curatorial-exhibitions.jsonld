{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/collection/georgia-okeeffe-museum-curatorial-exhibitions","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"RG.4.1.1","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":null,"type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe Museum. Curatorial. Exhibitions","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Acquisition information","id":"https://data.okeeffemuseum.org/terms/acqinfo"}],"content":"\u003cp\u003eThis collection was created and retained by the Georgia O'Keeffe Museum.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD arrangement","id":"https://data.okeeffemuseum.org/terms/arrangement"}],"content":"\u003cp\u003eMaterials arranged chronologically by exhibition. Within exhibitions, materials sorted by format type or function.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Preferred Citation","id":"https://data.okeeffemuseum.org/terms/prefercite"}],"content":"\u003cp\u003eGeorgia O'Keeffe Museum, Curatorial, Exhibitions, 1997-2015, undated. Georgia O'Keeffe Museum.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"The collection contains exhibition materials for exhibitions hosted at the Georgia O'Keeffe Museum between 1997-2015, including installation photography, checklists, and research. For exhibition ephemera and other published materials, see related record groups or the library.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eThe collection is open to the public for research purposes.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"This collection is the physical property of the Georgia O'Keeffe Museum. The Museum holds literary rights only for material created by Museum personnel or given to the Museum with such rights specifically assigned. The collection is subject to all copyright laws. The researcher assumes full responsibility for observing all copyright, property, and libel laws as they apply. Contact the Archivist for further copyright and publication information as it pertains to this collection.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Processing Information","id":"https://data.okeeffemuseum.org/terms/processinfo"}],"content":"\u003cp\u003eThis collection was processed by Hannah Yetwin in 2024.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003eCopies of materials may be made for research purposes only.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Scope and Content statement","id":"https://data.okeeffemuseum.org/terms/scopecontent"}],"content":"\u003cp\u003eThe Georgia O'Keeffe Museum Curatorial Exhibitions collection is comprised of material created by the Georgia O'Keeffe Museum's curatorial staff or hired contractors as it relates to exhibitions hosted by the Georgia O'Keeffe Museum. The collection documents the creation of exhibitions and their installation in the Museum's galleries, showing the shift in interpretation of O'Keeffe's work and related artists. Types of materials include installation photography, slides and transparencies of included works, checklists, correspondence and research. Published ephemera (including published checklists) and exhibition catalogs can be found in related collections or the library.\u003c/p\u003e\u003cp\u003eThe dates noted in the series title reflect the length of the exhibition, not the date range of materials created within the collection.\u003c/p\u003e","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}