{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/collection/georgia-okeeffe-abstraction-photographs","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":null,"type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"MS.15","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe Abstraction Photographs","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Scope and Content statement","id":"https://data.okeeffemuseum.org/terms/scopecontent"}],"content":"\u003cp\u003eThe collection includes two photographs and accompanying film of Georgia O'Keeffe and Juan Hamilton with her sculpture, Abstraction, 1946 cast 1979/1980 (Catalogue Raisonne numbers 1140 - 1142), at The Johnson Atelier.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003eCopies of materials may be made for research purposes only. The use of film materials requires permission of the archivist.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eThe collection is open to the public for research purposes. The photographic print materials may be accessed by researchers. The access of film materials requires the permission of the archivist.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Acquisition information","id":"https://data.okeeffemuseum.org/terms/acqinfo"}],"content":"\u003cp\u003eThese materials were donated to the Georgia O'Keeffe Museum by James Barton in June 2010.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"The collection is the physical property of the Georgia O'Keeffe Museum. The collection is subject to all copyright laws. The researcher assumes full responsibility for observing all copyright, property, and libel laws as they apply. Contact the Georgia O'Keeffe Museum Archivist for further copyright and publication information as it pertains to this collection.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Processing Information","id":"https://data.okeeffemuseum.org/terms/processinfo"}],"content":"\u003cp\u003eThis collection was processed by Elizabeth Ehrnst in 2010.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Preferred Citation","id":"https://data.okeeffemuseum.org/terms/prefercite"}],"content":"\u003cp\u003eGeorgia O'Keeffe Abstraction Photographs, 1979-1980. Georgia O'Keeffe Museum.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Two photographs and accompanying film of Georgia O'Keeffe and Juan Hamilton with her sculpture, Abstraction, 1946 cast 1979/1980 (Catalogue Raisonne numbers 1140 - 1142), at The Johnson Atelier.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}