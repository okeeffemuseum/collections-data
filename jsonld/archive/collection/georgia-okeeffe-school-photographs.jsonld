{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/collection/georgia-okeeffe-school-photographs","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"MS.10","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":null,"type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe School Photographs","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Collection consists of three black and white photographs of Georgia O'Keeffe, between 1903 and 1904.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"The collection is the physical property of the Georgia O'Keeffe Museum. The collection is subject to all copyright laws. The researcher assumes full responsibility for observing all copyright, property, and libel laws as they apply. Contact the Georgia O'Keeffe Museum Archivist for further copyright and publication information as it pertains to this collection.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003eCopies of materials may be made for research purposes only.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Scope and Content statement","id":"https://data.okeeffemuseum.org/terms/scopecontent"}],"content":"\u003cp\u003eCollection consists of three photographs of Georgia O'Keeffe: a school portrait of O'Keeffe dated 1903-09-16, a group photograph of Beta Chapter of Kappa Delta, inscribed with \"Basket Ball\" and names of group members, dated \"1903-04\", and a group photograph of Kappa Delta in formal dress inscribed with names of group members, dated \"1903-04\". Photos were probably taken while O'Keeffe was attending Chatham Episcopal Institute.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Biographical Historical statement","id":"https://data.okeeffemuseum.org/terms/bioghist"}],"content":"\u003cp\u003eKappa Delta Sorority was founded in 1897 on the beliefs of \"good fellowship, friendship and sisterly love among its members; the encouragement of literature and education; the promotion of social interest; and the furtherance of charitable and benevolent purposes\".\u003c/p\u003e\u003cp\u003eGeorgia O'Keeffe was a member of the sorority.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Acquisition information","id":"https://data.okeeffemuseum.org/terms/acqinfo"}],"content":"\u003cp\u003eThese materials were donated to the Georgia O'Keeffe Museum in April 2005 by Haile Parker McCollum on behalf of the family of Judith Maury Tice.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Processing Information","id":"https://data.okeeffemuseum.org/terms/processinfo"}],"content":"\u003cp\u003eProcessing of the collection was completed by Elizabeth Ehrnst in 2010.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Preferred Citation","id":"https://data.okeeffemuseum.org/terms/prefercite"}],"content":"\u003cp\u003eGeorgia O'Keeffe School Photographs, ca. 1903-1904. Georgia O'Keeffe Museum.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eThe collection is open to the public for research purposes.\u003c/p\u003e","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}