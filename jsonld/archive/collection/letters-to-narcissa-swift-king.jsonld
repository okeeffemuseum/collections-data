{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/collection/letters-to-narcissa-swift-king","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"MS.12","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":null,"type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Letters to Narcissa Swift King","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"The collection is the physical property of the Georgia O'Keeffe Museum. The collection is subject to all copyright laws. The researcher assumes full responsibility for observing all copyright, property, and libel laws as they apply. Contact the Georgia O'Keeffe Museum Archivist for further copyright and publication information as it pertains to this collection.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003eCopies of print materials may be made for research purposes only.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Scope and Content statement","id":"https://data.okeeffemuseum.org/terms/scopecontent"}],"content":"\u003cp\u003eThe collection includes seven letters from Georgia O'Keeffe to Narcissa Swift King dating from 1940 to 1971. The seven letters are brief and relate to the friendship between the two women.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Processing Information","id":"https://data.okeeffemuseum.org/terms/processinfo"}],"content":"\u003cp\u003eProcessing of the collection was completed by Elizabeth Ehrnst in 2010.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eThe collection is open to the public for research purposes.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Biographical Historical statement","id":"https://data.okeeffemuseum.org/terms/bioghist"}],"content":"\u003cp\u003eNarcissa Swift King (1910-1997) was heiress to the Chicago-based Swift meatpacking fortune and married to Clinton (Blair) King. A friend of Georgia O'Keeffe's, the two traveled across country to New Mexico in June of 1940. O'Keeffe may have titled her pastel Narcissa's Last Orchid for an orchid plant given to O'Keeffe by King.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"The collection includes seven letters from Georgia O'Keeffe to Narcissa Swift King dating from 1940 to 1971.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Acquisition information","id":"https://data.okeeffemuseum.org/terms/acqinfo"}],"content":"\u003cp\u003eThis collection was donated to the Georgia O'Keeffe Museum in 2003 by Robin Rowan Clarke.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Preferred Citation","id":"https://data.okeeffemuseum.org/terms/prefercite"}],"content":"\u003cp\u003eLetters to Narcissa Swift King, 1940-1971. Georgia O'Keeffe Museum.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD arrangement","id":"https://data.okeeffemuseum.org/terms/arrangement"}],"content":"\u003cp\u003eThe collection is arranged chronologically.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":"\u003cp\u003eThe letters from Narcissa Swift King to Georgia O'Keeffe are located in the Alfred Stieglitz / Georgia O'Keeffe Archive, Yale Collection of American Literature at the Beinecke Rare Book and Manuscript Library.\u003c/p\u003e","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}