{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_176b5dd014207ad019ede7f9f4870165","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_176b5dd014207ad019ede7f9f4870165","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"National Register of Historic Places","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"One letter from Thomas W. Merlan of the New Mexico Historic Preservation Division to Maria Chabot, Nov. 8, 1983. A draft of the \"National Register of Historic Places Inventory – Nomination Form\", Oct. 1982, with MC's margin notes and a letter from Betsy Swanson to MC, Nov. 12, 1982. One page of a letter from MC to Swanson, Nov. 24, 1982 [The letter is incomplete and without enclosures mentioned in the letter.] A note by MC, Feb. 22, 1983 and a letter from Betsy Swanson to MC, Mar. 10, 1983 with a copy of Swanson's interview with MC in a memorandum, dated March 9, 1983. A letter from MC to Betsy Swanson, Mar. 13, 1983, citing corrections needed in the Nomination Form and the interview and additions for the bibliography.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}