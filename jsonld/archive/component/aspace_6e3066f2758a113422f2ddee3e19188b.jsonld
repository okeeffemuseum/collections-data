{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_6e3066f2758a113422f2ddee3e19188b","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_6e3066f2758a113422f2ddee3e19188b","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Ships logs, journals, notebooks","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Three copies of: \"Daily Log of the S.S. \"Monfiore\" – Italian Freighter on which I sailed July 14 1937 from New Orleans, La. Arrived Aug. 9.'37. Genoa, Italy. – Maria Chabot – Written for my mother.\" [One hand written copy on, loose pages with an envelope; one typed copy in a handmade cardboard binder; one typed copy in a black ring-binder] Journals: loose journal pages, July 14 – Dec. 5, 1937, from Florence, Italy and Avignon, France; spiral notebook journal, Dec. 10, 1937 – Feb. 15, 1938, Greece and Tunisia; spiral notebook of notes on ancient pottery and note, Mar. 26, 1938, Nimes, France; spiral notebook journal, Apr. 18 and 26, 1938, France; spiral notebook journal, Apr.- Aug. 1938, Avignon, France.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}