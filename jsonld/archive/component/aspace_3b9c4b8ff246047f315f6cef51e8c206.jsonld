{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_3b9c4b8ff246047f315f6cef51e8c206","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_3b9c4b8ff246047f315f6cef51e8c206","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Pottery designs","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"The fourth binder contains an issue of El Palacio, six negatives of Pueblo women and pottery, MC notes on writings of various S.W. anthropologists, tracing of designs, a comparison of Pueblo and Chinese sexual symbols, and 35 photographs of Pueblo Bread with 10 other photographs of unknown subjects. Contains: issue of \"El Palacio\", negatives, notes on writings, comparison of Chinese and Pueblo symbols, tracing and photographs.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eRestricted due to culturally sensitive materials.\u003c/p\u003e","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}