{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_5999f20dc6b72a6aa1c69f046fa9250f","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_5999f20dc6b72a6aa1c69f046fa9250f","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2.2","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Halpert papers","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Business papers related to O'Keeffe's time represented by Edith Halpert and the Downtown Gallery, including materials such as receipts and invoices, painting lists, ephemera, and correspondence. Subjects reflected include pricing and sales, conservation treatments, framing, photography, and exhibition of artwork. O'Keeffe's orginal order maintained as much as possible, with files in rough chronological order. File titles in quotation marks reflect O'Keeffe's naming system for that file. As such, titles are not always an exact representation of file contents.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"Set"}