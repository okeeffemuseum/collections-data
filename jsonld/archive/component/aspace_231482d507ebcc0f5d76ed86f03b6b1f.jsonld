{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_231482d507ebcc0f5d76ed86f03b6b1f","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.6.953","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_231482d507ebcc0f5d76ed86f03b6b1f","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe in Abiquiu Patio","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Mary E. Nichols","id":"actor/ulan/500243317","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Portrait of O'Keeffe sitting on a banco in the patio of her Abiquiu house surrounded by a collection of rocks; she is wearing a black suit coat, black pants, a white shirt and a black scarf which covers her hair; she sits with body turned slightly to viewer right, her left leg is crossed over her right knee and her arms are crossed over her lap, her face in partial profile, a shaft of diagonal light illuminates the midsection of her body and the collection of rocks around her feet in the foreground.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":["\u003cp\u003ePhotograph was featured in Architectural Digest July 1981\u003c/p\u003e"],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003ewww.okeeffemuseum.org/image-rights-and-reproduct