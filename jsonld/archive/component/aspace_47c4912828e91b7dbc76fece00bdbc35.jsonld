{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_47c4912828e91b7dbc76fece00bdbc35","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_47c4912828e91b7dbc76fece00bdbc35","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"San Antonio","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Various notes and musings of a literary nature found together in a folder labeled San Antonio, that probably were written there but do not directly concern the town. There is a piece, titled Adolescence, which is written on the back of stationary imprinted, Mary L. Chabot, 427 Madison Street, San Antonio, Texas. Mary Lee Chabot was Maria Chabot's legal name. Also in this file are three essays and some short pieces which do concern San Antonio, but were not found with the other writings.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}