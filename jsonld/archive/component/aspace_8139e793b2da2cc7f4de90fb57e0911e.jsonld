{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_8139e793b2da2cc7f4de90fb57e0911e","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_8139e793b2da2cc7f4de90fb57e0911e","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Ecuador and Peru trip","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Three spiral notebooks - South America, 1988; South America, Ecuador, 1988; Peru, 1988; one motel reservation receipt, Miami; one itinerary for the trip. One photocopied set of pages from a travel guidebook on Ecuador; one hotel brochure, one map of Ecuador. One page of notes on bus connections from Oaxaca, Mexico to Lima, Peru; one sheet of notes and a hotel card; two sets of photocopied pages from a travel guidebook on Lima, Peru and on Trujillo, Peru; photocopied page of the itinerary concerning Peru; a set of photocopied pages on the Incas, Cuzco, and Machu Picchu; a constellation chart.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}