{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_3ddd6ee898f04fa7b2ed1b88061226c0","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_3ddd6ee898f04fa7b2ed1b88061226c0","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"\"A Personal Reflection\"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Thirty pages of handwritten reflections by Maria Chabot on her life based primarily on her many years of self-psycho-analysis [This is written on an 8x5 inch pad and is with the envelope in which it was found. On the envelope in MC's hand is written the title, date of the writing - ca. 1950, and an outline of the contents. This document summarizes the content of the many files which follow it in this box.]","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}