{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_ef82f1facb2aa566a51ed17c97da9af6","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"3","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_ef82f1facb2aa566a51ed17c97da9af6","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Research and writing","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"The Research and Writing series is arranged into five major subseries. They are Literary work, General interests, Southwest American Indians, Hispano and Mexican culture, Georgia O'Keeffe book, and Christiane Gallet biography. The literary work subseries contains original fiction and non-fiction writing by Chabot. The general interests subseries includes research and notes on miscellaneous topics. The Southwest American Indians and Hispano and Mexican cultures subseries include both research and writing by Chabot. The bulk of the Georgia O'Keeffe subseries is an unpublished manuscript by Chabot about her experiences living and working with O'Keeffe. The Christiane Gallet biography subseries includes materials related to the unpublished biography and is currently restricted.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"Set"}