{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_8fde60cb2d31e640504eed622a09e3db","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_8fde60cb2d31e640504eed622a09e3db","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Linguistics notes","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Access restriction statement","id":"https://data.okeeffemuseum.org/terms/accessrestrict"}],"content":"\u003cp\u003eRestricted due to culturally sensitive materials.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"The third binder contains an issue of El Palacio, MC notes on Tewa and other Pueblo, languages. These include notes taken from Chabot's San Juan informants, Tony Garcia and Paul Cata. This binder also includes two letters between Chabot and Alice Marriott, April, 22, l1958 \u0026 April 30, 1958, commenting on the informants. Paul Cata is also the model for MC's unpublished short story, \"The Curtain of Feeling,\" see: MCA – Literary Notes – Novels/Short Stories. Contains: issue of \"El Palacio\", notes on Pueblo languages.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}