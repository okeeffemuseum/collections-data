{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_54be1a0251a7fa7c6e58c6545bba91de","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_54be1a0251a7fa7c6e58c6545bba91de","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Interview with Christiane Gallet, reel","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Processing Information","id":"https://data.okeeffemuseum.org/terms/processinfo"}],"content":"\u003cp\u003eBefore digitization, these tapes were believed to be interviews with Georgia O'Keeffe, and were therefore filed in this collection under Research and Writing: Georgia O'Keeffe book [box 102, folder 7]. After digitization by BAVC Preservation, they have since been moved to this current location, since the interviewee appears to be Christiane Gallet.\u003c/p\u003e\u003cp\u003eReel 1 BAVC No.: 1006165; reel 2 BAVC No.: 1006166.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Two 5\" tape reels. Reel #2 contains interview with Christiane Gallet. Reel #1 is of a meditation session.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/839314/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_l