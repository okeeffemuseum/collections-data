{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_542baad2c757c0546a2ca0f77acf1622","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_542baad2c757c0546a2ca0f77acf1622","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Holiday card","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Laura Gilpin","id":"actor/ulan/500021305","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":["\u003cp\u003eMaterial originally located in the publication Emergence Myth According to the Hanelthnayhe or Upward-reaching rite (E99.N3 W54). Found between pages 32-33.\u003c/p\u003e"],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Holiday card from Laura Gilpin to unknown (possibly Georgia O'Keeffe) containing four photographs by Gilpin, one photograph on each side of the card. Handwritten text reads \"New Years Greetings from the Land of the Drum\" on the front, \"and the best wishes of Laura Gilpin\" on the back. Interior text includes a handwritten caption for the interior photographs.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}