{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_8489751fe978b036d2362916fb26832e","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_8489751fe978b036d2362916fb26832e","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Mexico","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Notes, a notebook, memorabilia, a guidebook and twelve post cards of archaeological sites (many with notes on the back), seven postcards of church architecture (also with notes on the back), and thirty-seven photographs. Among the photographs are five portrait photos of Maria Chabot made by Dorothy N. Stewart, twenty photos of people and places in Mexico, three photos of Chabot bathing nude taken by Stewart, and seven photos of Chabot, Stewart, and their other traveling companions, Kathryn \"Casey\" Hulme and Alicia Rohrer. Many photos have notes and identification on the backs.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"Set"}