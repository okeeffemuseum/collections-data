{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_cc94b9bb7c37e7c7f2c7626e722eb919","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_cc94b9bb7c37e7c7f2c7626e722eb919","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Dorothy Stewart to and from Margretta Dietrich","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"MARGRETTA STEWART DIETRICH [a.k.a. \"Sister Pig\"; \"Piggy\"; \"Peeg\"; \"Pat\"; Mrs. Charles H. Dietrich] Correspondence from Dorothy Stewart to Margretta Dietrich: Twenty-three letters and four postcards, Dec. 17, 1927 - Sept. 3, 1938. The letter of April 26, 1933 contains the first mention of Chabot, \"the Texas girl.\" The letters of 1937 and 1938 concern their trip together in Europe. Many of the letters from Europe are illustrated, especially the letter of April 28, [1938].","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}