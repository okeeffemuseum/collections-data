{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_1b9a03c51f3e0bad4ce7052309645603","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_1b9a03c51f3e0bad4ce7052309645603","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Gallet and family, unidentified photographs","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"There are ten photographs of Christiane Gallet and members of her family in this box. There are three photographs of a woman, who looks like Olive Chabot [Chabot's mother] feeding white turkeys. It may have been taken by Gallet. It was found with this correspondence in an envelope, which clearly misidentified the contents. Also found with this correspondence were two unidentified photographs, which might be Christiane Gallet and her daughter, Astrid.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}