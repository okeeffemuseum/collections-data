{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_2d610d5a3c560ad70ff33ab9d438e322","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_2d610d5a3c560ad70ff33ab9d438e322","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Mary Wheelright to Irene Zelinski","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Two letters from Mary Cabot Wheelwright to Irene Zelinski are also contained in this box. The letter of Dec. 19, [1955] is written from Oaxaca and mentions the arrival of Dorothy Stewart there. The letter of Jan. 10, [1957] confirms that Wheelwright will be using Wight's San Francisco apartment [see: Chabot to Zelinski – Oct. 6, 1956 and after.]","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}