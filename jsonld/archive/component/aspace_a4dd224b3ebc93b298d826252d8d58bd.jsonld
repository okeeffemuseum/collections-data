{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_a4dd224b3ebc93b298d826252d8d58bd","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_a4dd224b3ebc93b298d826252d8d58bd","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Two journal pages, poem, and clipping","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Journal pages, May 8, 1938 and May 16, 1938, written in Villeneuvre-les-Avignon, but the entries concern Maria Chabot's family relationships found with a poem concrete, \"Fisches Nachtgesang\" [Fishes's Night Hymn], no author or date. Newspaper clipping concerning Maria Chabot's return to San Antonio with Dorothy Stewart.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}