{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_1a1c5dc6a0cdcf9748110a946dc2186e","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_1a1c5dc6a0cdcf9748110a946dc2186e","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.6.719","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe at Lake George","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/ulan/500125274","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Photograph of Georgia O'Keeffe on a boat during her first visit to Lake George with other students of the Art Students' League. An unknown man sits next to her. Photograph includes an envelope with typed text: \"envelope #1//first trip to Lake George//5 pix of OKeeffe [sic]//1 (on lake) with students of Art Students League (NY)//1 on bench, sun-dappled, (1915?)//3 of Georgia by trees by the lake, age about 20;\" and handwritten in O'Keeffe's hand: \"Lake George from League.\"","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003ewww.okeeffemuseum.org/image-rights-and-reproductions/\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://d