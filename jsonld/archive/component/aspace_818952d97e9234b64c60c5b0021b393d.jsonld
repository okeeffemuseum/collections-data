{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300026877","label":"correspondence","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300026867","label":"clippings (information artifacts)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_818952d97e9234b64c60c5b0021b393d","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2016.6.101","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_818952d97e9234b64c60c5b0021b393d","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe to Anita O'Keeffe Young","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/ulan/500018666","type":"Actor"},{"_label":"Doris Bry","id":"actor/naf/n88015082","type":"Actor"},{"_label":"Whitney Museum of American Art (est. 1930)","id":"actor/ulan/500303638","type":"Actor"},{"_label":"Young, Anita Natalie O'Keeffe, 1891-1985","id":"actor/archive/young-anita-natalie-okeeffe-1891-1985","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Two page letter dated 1971-05-18 from Georgia O'Keeffe to Anita O'Keeffe Young in which several items were enclosed. Enclosures include: a 1970-12-17 letter from the director of the Whitney Museum of American Art to Georgia O'Keeffe discussing the recently closed O'Keeffe exhibition; a 1970-10-26 five-page article from \"New York\" titled \"The Arrogance of Culture Power\" by Sophy Burnham with a previously stapled note, \"Miss O'Keeffe asked me to send you these. D.B [Doris Bry].\" The note from Doris Bry regarding the sent article is dated 1971-04-17.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003ehttps://www.okeeffemuseum.org/image-rights-and-reproductions/\u003c/p\u003e","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/793393/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/793393"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/iiif/2/793394/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/iiif/2/793394"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/793395/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/3002153