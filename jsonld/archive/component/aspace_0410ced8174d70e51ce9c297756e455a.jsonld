{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_0410ced8174d70e51ce9c297756e455a","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.6.270","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_0410ced8174d70e51ce9c297756e455a","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Castle Herend","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/ulan/500125274","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Castle Herend dating from 1500 near Budapest. Supposedly the home of Georgia O'Keeffe's relatives on her mother's side. Handwritten on verso: \"The castle of Herend in Hungary. It was built in the XVI century by count Euldarhary [sp?]. Herend is in Hungary in the district of vepreus [sp?].\" Handwritten on recto: \"Castle of Herend near Budapest, built 1500 Totto home.\"","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Restrictions on use","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":"\u003cp\u003ewww.okeeffemuseum.org/image-rights-and-reproductions/\u003c/p\u003e","type":"LinguisticObject"}],"representation":[{"digitally_shown_by"