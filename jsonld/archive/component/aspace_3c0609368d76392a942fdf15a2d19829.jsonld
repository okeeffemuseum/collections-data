{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_3c0609368d76392a942fdf15a2d19829","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_3c0609368d76392a942fdf15a2d19829","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Deeds, appraisals, real estate, maps","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Eleven sheets concerning the title history of Los Luceros. Six sheets: letter from W.W. Hunker to Oliver Seth, March 11, 1959, concerning Bishop, Manuel and Hunker appraisal of Los Luceros land for Maria Chabot with three copies of \"Note\". Two sheets: Lyle E. Teutsch real estate listing for Los Luceros, Mar. 14, 1959, 2 copies. Four sheets: P.F. McCanna Co. real estate listing for Los Luceros, Nov. 4, 1959 and Nov 5, 1959 [2 copies]. Two sheets: real estate listing, signed by MC, June 1960 [The form is the same as the P.F. McCanna forms but is not headed.] Two sheets: two traced maps of Los Luceros land found without context, undated.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}