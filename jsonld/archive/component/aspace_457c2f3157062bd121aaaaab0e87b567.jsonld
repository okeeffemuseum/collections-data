{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_457c2f3157062bd121aaaaab0e87b567","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_457c2f3157062bd121aaaaab0e87b567","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"\"Painting Photo Numbers\"","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"List of paintings and the corresponding number assigned to the photograph of the painting. Painting photos can often be found with their factsheets in the Abiquiu Notesbooks. Photo numbers start with photographer's surname, i.e. \"Baker #5413.\" The list is an incomplete representation of photos of paintings found in the Abiquiu Notebooks.","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}