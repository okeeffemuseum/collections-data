{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_b4641591dec337d23e827f81a2b817c8","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_b4641591dec337d23e827f81a2b817c8","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"1","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Correspondence","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Biographical Historical statement","id":"https://data.okeeffemuseum.org/terms/bioghist"}],"content":"\u003cp\u003eName variation for Aina. Also known as Aino or Ina in correspondence between O'Keeffe, Stieglitz, and Chabot. Aina was the housekeeper for O'Keeffe ans Stieglitz in New York. Refered to as Finnish and is described as being 26 years old in March of 1944.\u003c/p\u003e","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"Set"}