{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/archive/component/aspace_305dfc42baffc78bb6ee243a3f889ba1","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"aspace_305dfc42baffc78bb6ee243a3f889ba1","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Japan and Korea trip","type":"Name"}],"produced_by":{"carried_out_by":[],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"EAD Legal status statement","id":"https://data.okeeffemuseum.org/terms/userestrict"}],"content":null,"type":"LinguisticObject"},{"classified_as":[{"_label":"abstract","id":"https://data.okeeffemuseum.org/terms/abstract"}],"content":"Two small spiral notebooks on Japan; two small spiral notebooks on Korea; 2 maps of Seoul; eight postcards [three have notes]; two brochures and two entry ticket stubs to temples; typed meditation chant; note pad of notes, bank receipt, and \"Ford's Freighter Travel Guide\" order form; Travel agent's list of steam ship lines; \"The Kounovsky Secret of Lifetime Fitness\"; two mimeographed essays by Paul Schmidt, UNM philosophy professor, inspired by the 1972 trip.","type":"LinguisticObject"},{"classified_as":[{"_label":"EAD Related Material","id":"https://data.okeeffemuseum.org/terms/relatedmaterial"}],"content":[],"type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}