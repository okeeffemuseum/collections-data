{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/199","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe: Abstract Variations","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Seattle Art Museum","id":"actor/1434","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"The exhibition at the Seattle Art Museum (SAM) in 2020 was a one-room show featuring \"Music, Pink and Blue, No. 1,\" which is now part of SAM's permanent collection. The exhibition also included \"Music, Pink and Blue, No. 2\" and other related works to showcase O'Keeffe's experimentation with abstraction and her connection between art and music.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}