{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/880","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe: \"My New Yorks\"","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Art Institute of Chicago","id":"actor/381","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Georgia O’Keeffe: My New Yorks is the first exhibition to seriously investigate the artist’s paintings, drawings, and pastels of New York City’s built environment. The show will demonstrate how integral these compositions were to her modernist investigation of abstracted form in the 1920s and beyond.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}