{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/882","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The Nature of Glass","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"New Mexico Museum of Art","id":"actor/728","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"This exhibition explores how artists working with glass have engage both the natural world as content for their work and the nature of glass as a medium.  The Steuben glass bowl with Jimson Weed highlights O'Keeffe's ability to translate her distinctive vision into the medium of glass.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}