{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/78","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Georgia O'Keeffe: Beyond Our Shores","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe Museum","id":"actor/1","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"This exhibition presents a selection of rarely seen O'Keeffe works inspired by her travels outside of the United States: Bermuda (1933 and 1934), Hawaii (1939 and before it became part of the United States), Peru (1957), and Asia (1959 and 1960). these works have never been exhibited together among them are two oil paintings O'Keeffe completed while in Hawaii as guest of the dole Pineapple Company that had commissioned her to make paintings that would be reproduced in its advertising campaigns.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}