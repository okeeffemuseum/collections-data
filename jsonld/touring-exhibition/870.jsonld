{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/870","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"O'Keeffe in the Landscape","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe Museum","id":"actor/1","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"O’Keeffe spent ample time in nature while living in New Mexico, gathering inspiration for her artwork and developing a personal relationship with the landscape. This exhibition will highlight photographs of O’Keeffe, the clothing she wore, and the objects she brought with her on her excursions.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}