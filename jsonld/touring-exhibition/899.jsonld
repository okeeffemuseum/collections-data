{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/899","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Modernist Circle","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe Museum","id":"actor/1","type":"Actor"},{"_label":null,"id":"actor/401","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"The exhibition introduces key American artists of the Stieglitz Circle and their shared connections and artistic intentions through materials primarily from O’Keeffe’s personal library and archive. Objects on display in cases and library special collections shelving will include books by and about the Circle artists, relevant ephemera and photographs that illustrate the connections within the group. Paintings on display represent artists from the Circle held by the O’Keeffe Museum.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}