{"classified_as":[{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/touring-exhibition/61","identified_by":[{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Edward Weston: Photography and Modernism","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Museum of Fine Arts (MFA Boston)","id":"actor/1380","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"This exhibition demonstrates the extraordinary strength and variety of Weston's work, from his first experiments with modernism, about 1920, until Parkinson's disease forced him to stop photographing in 1948. The vintage Weston photographs in this exhibition demonstrate the photographer as an artist who made a major contribution to the art of his time.","type":"LinguisticObject"}],"representation":[],"type":"Activity"}