lete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"George Daniell. Georgia O'Keeffe, 1952. Gelatin silver print, 10 3/8 x 6 5/16 inches. Georgia O'Keeffe Museum. Museum Purchase. © Estate of George Daniell. [2014.3.31]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Portrait of Georgia O'Keeffe holding a black poodle while sitting on the steps of the doorway in the adobe walled courtyard of her Abiquiu house; she is wearing a long black coat, a black hood, black leather gloves, the poodle is standing on its hind legs with its paws leaning on O'Keeffe's lap; triangular dark shadows across lower edge of photograph and upper corner of doorway.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Estate of George Daniell","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/795385/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/795385"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}