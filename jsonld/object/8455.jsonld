ata.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Elizabeth Stieglitz Davidson, Mamaroneck, New York, gift, 1920s \nElizabeth Margery Bodkin, New York, NY, gift, 1943 \nIrma Rudin, New York, NY, purchase, 1977 \nJacqueline Anhalt Gallery, Los Angeles, California, 1978 \nHeritage Gallery, Los Angeles, California, c. 1979 \nPrivate collection, Charlottesville, Virginia, 1979 \nGerald Peters, Santa Fe, N.M.,  (nd) \nAddison Rowe Galleries, Santa Fe, N.M., 2025 \n(Source: Georgia O'Keeffe Museum, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive, Downtown Gallery Archive. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Sunflower, 1921. Oil on board, 15 x 12 inches. Private Collection. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"15 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Sunflower, 1921","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"http