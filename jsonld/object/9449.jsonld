pe":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. It Was Red and Pink, 1959. Oil on canvas, 30 x 40 inches. Milwaukee Art Museum. Milwaukee Art Museum, Gift of Mrs. Harry Lynde Bradley M1977.135. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Milwaukee Art Museum, Gift of Mrs. Harry Lynde Bradley M1977.135","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"It Was Red and Pink, 1959","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"[1] By April 11, 1961, (The Downtown Gallery, New York, New York, USA); [2] May 4, 1961, purchased by Mrs. Harry Lynde (Margaret, or Peg, Blakney Sullivan) Bradley [1894–1978] (Milwaukee, Wisconsin, USA); [3] June or December 1969, gift to The Bradley Family Foundation; 1977, gift to Milwaukee Art Center (Milwaukee, Wisconsin, USA) \nNOTES: \n[1] Downtown Gallery, Georgia O'Keefe: Recent Paintings \u0026 Drawings (New York: The Downtown Gallery, 1961), cat. 3. \n[2] Invoice addressed to Mrs. Harry Lynde Bradley in MAM object file, marked paid by “Mrs. B.” on June 26, 196. See also Barbara Buhler Lynes, Georgia O'Keeffe: Catalogue Raisonne. Vol. 2 (New Haven, CT: Yale University Press, 1999), p. 850, cat. 1358. \n[3] Documentation from The Bradley Family Foundation in MAM object file; both dates are listed on different sources. See also Barbara Buhler Lynes, Georgia O'Keeffe: Catalogue Raisonne. Vol. 2 (New Haven, CT: Yale University Press, 1999), p. 850, cat. 1358. \n(Source: MAM, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive. Titled *It Was Red and Pink* by O'Keeffe on Abiquiú Notebooks photograph. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 30 x 40 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862539/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862539"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}