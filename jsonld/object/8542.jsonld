ms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Miss O'Keeffe thinks this was sold to Mrs. W. Gordon Mills (Doris Eustice Mills).\" Whitney Archive, Abiquiú Notebooks indicate, \"Note: Letter to Mrs. Mills returned –– address unknown.\" (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 32 1/16 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Eggplant, 1924. Oil on canvas, 32 1/16 x 12 inches. Art Gallery of Ontario. Donated in memory of Doris Huestis Speirs by her husband, Dr. J. Murray Speirs, 1990. Art Gallery of Ontario. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Donated in memory of Doris Huestis Speirs by her husband, Dr. J. Murray Speirs, 1990. Art Gallery of Ontario","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"32 1/16 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Eggplant, 1924","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Art Gallery of Ontario","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A dark purple eggplant with a twisting green stem sits on a surface covered with draped white fabric. The fabric runs the length of the narrow, portrait-oriented composition.","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The Artist throught Exhibition, Alfred Stieglitz Presents, Seven Americans. March 9-March 28, 1925; Purchase, Doris Huestis Mills Speirs; By descent,  her husband, Dr. J. Murray Speirs; Gift to Art Gallery of Ontario, 1990 \n(Source: Art Gallery of Ontario, 2025)","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794721/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794721"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}