{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300078925","label":"watercolors (paintings)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8360","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"224, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"224","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8360","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Pink and Green Mountain No. IV","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive.","title":"Pink and Green Mountains IV","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: backing inscription, Abiquiú Notebooks.","title":"Pink and Green Mountain No. IV","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive. \"H 56\" on backing inscription is Downtown Gallery inventory number. See cat. nos. 1797, 1801, 1802. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Robert Miller Gallery, Inc., New York, NY); Bill Dean, New York, NY, 1985; Dan Liberman, St. Louis, Missouri, 1985; Owings-Dewey Fine Art, Santa Fe, New Mexico, 1986; Private collection, Fort Worth, Texas, 1987; (Gerald Peters Gallery, Santa Fe, New Mexico) (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A red canna lily with dark purple and blue leaves contrasts with a plain white background. The leaves and petals are soft and richly colored.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"9 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Pink and Green Mountain No. IV, 1917. Watercolor on paper, 9 x 12 inches. Private Collection. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Pink and Green Mountain No. IV, 1917","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Watercolor on paper","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Watercolor on paper, 9 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794747/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794747"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}