{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300078925","label":"watercolors (paintings)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/151","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"235, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"235","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"151","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2007.1.9","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: label printed by O'Keeffe (white).","title":"Figure in Black","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Figure in Black","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Private Collection*","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Watercolor and graphite on moderately thick, cream, smooth wove paper with a slightly fuzzy feel\n(Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks. Completed in San Antonio, See cat. no. 228. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Loosely painted watercolor on the upper half of the page.  An orange oval is in the center with an area of black around it, set in a ground of muddy brown.  The graphite drawing is visible and on either side of the orange area are two small pear-shaped loops.  This artwork has *Untitled (Leah)*, 1918 (cat. no. 241) on the back.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Watercolor and graphite on paper","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Estate of the artist, 1986; Private collection, 1987 (Mongerson Wunderlich, Chicago, IL); Gerald Peters Gallery, Santa Fe, NM \u0026 Owings-Dewey Fine Art, Santa Fe, 1994 (Owings-Dewey Fine Art, Santa Fe, NM) (Source: Georgia O'Keeffe Museum)","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"8 7/8 x 6 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Watercolor and graphite on paper, 8 7/8 x 6 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Figure in Black, 1918","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Figure in Black, 1918. Watercolor and graphite on paper, 8 7/8 x 6 inches. Georgia O'Keeffe Museum. Gift of The Burnett Foundation. © Private Collection*. [2007.1.9]","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of The Burnett Foundation","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/789890/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/789890"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}