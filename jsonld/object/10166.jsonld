{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/10166","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1103","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"10166","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1103, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks, 1946 New York (An American Place) exhibition checklist.","title":"Cebolla Church","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Cebolla Church","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Exam. at Amer. Place, March 1946.... No signature.\" O'Keeffe wrote: \"About thirty miles north of where I live in New Mexico is a small village called Cebolla, with sharply pitched, rusted tin roofs.... The country is one of the poorest areas in the United States and the life of the people is difficult.... So I painted the Cebolla church which is so typical of that difficult life\" (*Georgia O'Keeffe* [1976], unpaginated, text accompanying entry 69). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"North Carolina Museum of Art, Raleigh, Gift of the North Carolina State Art Society (Robert F. Phifer Bequest), in honor of Joseph C. Sloane","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Cebolla Church, 1945. Oil on canvas, 20 1/16 x 36 1/4 inches. North Carolina Museum of Art. North Carolina Museum of Art, Raleigh, Gift of the North Carolina State Art Society (Robert F. Phifer Bequest), in honor of Joseph C. Sloane. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"North Carolina Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 20 1/16 x 36 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"20 1/16 x 36 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Cebolla Church, 1945","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A light brown church with a gray-pitched roof stands on an expanse of green earth. Only one side of the church is visible. A low steeple with a white cross atop it protrudes from the church's roof. Two white-trimmed windows offer a glimpse into the dark interior of the church. Stretching out overhead, a smooth blue sky features a few long, thin clouds hovering at the top of the work.","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Created New Mexico, 1945; collection of the artist, Abiquiu, NM; [The Downtown Gallery, New York, NY]; Allen Memorial Art Museum, Oberlin College, Oberlin, OH, 1947; [Plaza Galleries, New York, May 14, 1953, no. 100]; [The Downtown Gallery, New York]; Mr. and Mrs. George Kogel, King’s Point, NY, 1956; [Richard Gray Gallery, Chicago]; private collection, Chicago, IL; [Richard Gray Gallery, Chicago, 1971]; [Goodman Gallery, San Francisco, CA, 1972]; [Kennedy Galleries, New York, 1972]; sold to NCMA, 1972. \n(Source: NCMA, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863343/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863343"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}