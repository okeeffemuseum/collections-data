{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/9035","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.6.1498","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"9035","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Glen Canyon Album: Colorado River Raft Trip","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Todd Webb","id":"actor/1155","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Todd Webb. Glen Canyon Album: Colorado River Raft Trip, 1961. Photographic album. Georgia O'Keeffe Museum. Gift of The Georgia O'Keeffe Foundation. © Todd Webb Archive. [2006.6.1498]","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Photographic album","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"\"in memory of the great August 1961 trip down the Colorado River.\"","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"This is the album that Todd Webb gave to Georgia O'Keeffe \"in memory of the great August 1961 trip down the Colorado River.\" The album consisting of 89 photographs taken by Todd Webb documents the seven-day, 180-mile Colorado River Raft trip that would follow the routes of John Wesley Powell and Norman Neville.  The 11 participants of the rafting trip group included Georgia O'Keeffe, Todd Webb, Eliot Porter, Steve Porter, Kathy Porter, Tish Frank, Doris Bry, Quida Ball, Mike Harding, Marhsall Girard ( Sandra Girard's son), and Kenney Ross, a guide from Moab.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Todd Webb","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Todd Webb Archive","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Photographic album","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of The Georgia O'Keeffe Foundation","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Glen Canyon Album: Colorado River Raft Trip, 1961","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}