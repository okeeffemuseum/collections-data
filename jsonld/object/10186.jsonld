{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/10186","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1265","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1265, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"10186","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive, Abiquiú Notebooks, Whitney Archive in 1969.","title":"Wall with Green Door","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Wall with Green Door","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Wall with Green Door, 1953","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"National Gallery of Art, Washington, Corcoran Collection (Gift of the Woodward Foundation, 1977), 2015.19.155","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Wall with Green Door, 1953. Oil on canvas, 30 x 47 7/8 inches. National Gallery of Art (NGA). National Gallery of Art, Washington, Corcoran Collection (Gift of the Woodward Foundation, 1977), 2015.19.155. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Doris Bry [1920-2014], New York).[1] (Noah Goldowsky Gallery, New York). Woodward Foundation, Washington, by 1966;[2] gift 1977 to the Corcoran Gallery of Art, Washington; acquired 2015 by the National Gallery of Art. (Source: NGA, 2025) \n \n[1] The first two owners are given in Barbara Buhler Lynes, _Georgie O'Keeffe: Catalogue Raisonné_, 2 vols., New Haven and London, 1999: 2:789, no. 1265. In a letter of 8 August 1953, the artist wrote to Edith Halpert that one of the four paintings she had sent that day to the Downtown Gallery was \"Wall with Green Door/53\" (Downtown Gallery Records, Archives of American Art, Smithsonian Institution, Washington, cited in Lynes 1999). The painting was lent by Miss O'Keeffe through the Downtown Gallery to a 1960 exhibition of her work at the Worcester Art Museum, and there is a Downtown Gallery label on the reverse, on which the painting is given number 166. \n \n[2] The 1966 date is according to Lynes 1999, 2:789, no. 1265.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"30 x 47 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"National Gallery of Art (NGA)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 30 x 47 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A band of beige paint stretches across the frame. Below is a narrower band in a slightly lighter shade. A green square hovers at the center of the composition, with a thin strip of blue at the top.","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Abiquiú Notebooks, Whitney Archive in 1969 date 1952. Downtown Gallery Archive dates 1953. \"Today I have sent you four painting by express. Wall with Green Door /53. .\" (O'Keeffe to Edith Halpert, 8 August 1953, Archive of American Art). (Source: Lynes, 1999)"],"type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857697/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857697"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}