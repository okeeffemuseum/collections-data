{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/7496","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"7496","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2016.2.68","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Los Hermanos de Nuestro Padre Jesus - Penitentes, Colorado - Father Roy","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Myron Wood","id":"actor/11","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Gelatin silver print","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Myron Wood","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Myron Wood. Los Hermanos de Nuestro Padre Jesus - Penitentes, Colorado - Father Roy, ca. 1980. Gelatin silver print, 13 1/4 x 18 13/16 inches. Georgia O'Keeffe Museum. Museum Purchase. © Pikes Peak Library District (Colorado Springs). [2016.2.68]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Interior, church, altar, statues, religious figurines, crucifix, candles, men; Daytime view of rustic church interior with vigas, wooden plank floors and 11 men ( of various ages) seated on a wooden bench in front  of the altar; white cloth draped altar with religious figurines, kneeling angels, candles, etc., wooden painted crucifix of Jesus dripping blood,  large full length statue of Mary with praying hands to the side of the altar, a metal shaped Christmas tree-form with candles positioned in front of the altar and behind the row of men.  Raking light coming from what would be a window from the left of the picture plane illuminates the row of men's faces, the plank floors are part of the altar.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Los Hermanos de Nuestro Padre Jesus - Penitentes, Colorado - Father Roy, ca. 1980","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Pikes Peak Library District (Colorado Springs)","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Museum Purchase","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Gelatin silver print, 13 1/4 x 18 13/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"13 1/4 x 18 13/16 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799340/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799340"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}