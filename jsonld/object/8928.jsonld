sified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"[Doris Bry, New York] \n \n \n[Harold Diamond, Inc., New York, to 1972] \n \n \n[B.C. Holland, Chicago, 1972‑1973] \n \n \nHerbert Palmer, Los Angeles, 1973‑1974 \n \n \nClare Boothe Luce, Honolulu, 1974‑1983 \n \n \n[Howard Beilin, Inc., New York, 1983] \n \n \n[Salander‑O'Reilly Galleries, New York, c. 1983‑ c. 1984] \n \n \n[Coe Kerr Gallery Inc., New York, by 1984‑1987]   \n \n[Christie's, New York (sale no. 6402, \"Important American Paintings, Drawings and Sculpture of the 18th, 19th and 20th Centuries,\" lot 289A, p. 274, repr. p. 275), 29 Ma7 1987, bought in] \nMillicent Rogers Museum of Art, Taos, New Mexico, 1987‑1989 (received as gift for purposes of sale) \nHonolulu Academy of Arts, Honolulu, 1989 \n(Source: Honolulu Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 19 x 16 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/858494/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/858494"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}