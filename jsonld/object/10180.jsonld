d_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on board","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Brooklyn Bridge, 1949. Oil on board, 47 15/16 x 35 7/8 inches. Brooklyn Museum of Art. Bequest of Mary Childs Draper. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"The Brooklyn Bridge's two pointed arches offer a view of the blue sky beyond. The bridge's towers, painted solid black, frame the arches. Cables arch across the composition, creating checkerboard patterns on the visible patches of sky.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on board, 47 15/16 x 35 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Downtown Gallery Archive, N.Y.C. until 1958, Mary Childs Draper, Brooklyn until 1977, Brooklyn Museum, 1977 (Source: Brooklyn Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Bequest of Mary Childs Draper","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id"