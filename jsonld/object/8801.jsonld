{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8801","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"791","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8801","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"791, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Bear Lake","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title":{"titles":[{"notes":"Source of title: New Mexico Museum of Art.","title":"Desert Abstraction","type":"alternate-title"}],"type":"alternate-title"},"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Abiquiú Notebooks after 1977.","title":"A Desert Landscape","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"selected-exhibition-titles":{"titles":["Untitled (Desert Abstraction Bear lake)\nPlaces of their Own: Emily Carr, Georgia O'Keeffe and Frida Kahlo, 2001, McMichael Canadian Art Collection","Untitled (Desert Abstraction Bear Lake)\nPlaces of their Own: Emily Carr, Georgia O'Keeffe and Frida Kahlo, 2001, New Mexico Museum of Art (Santa Fe)","Untitled (Desert Abstraction Bear Lake)\nPlaces of their Own: Emily Carr, Georgia O'Keeffe and Frida Kahlo, 2002, National Museum of Women in the Arts (Washington)","Untitled (Desert Abstraction Bear Lake)\nPlaces of their Own: Emily Carr, Georgia O'Keeffe and Frida Kahlo, 2002, Vancouver Art Gallery (Vancouver)","Desert Abstraction\nGeorgia O'Keeffe: \"My New Yorks\", 2024, Art Institute of Chicago (Chicago)","Desert Abstraction\nGeorgia O'Keeffe: \"My New Yorks\", 2024, High Museum of Art (Atlanta)"],"type":"selected-exhibition-titles"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: on basis of Stieglitz–O'Keeffe correspondence.","title":"Bear Lake","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["New Mexico Museum of Art displays a different orientation (flipped vertically) than that shown in Lynes, 1999 which was based on O'Keeffe's records. (Source: Information provided to *Access O'Keeffe* from the New Mexico Museum of Art, 2025)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Low orange and brown hills, sloping diagonally across the composition, open up to reveal the dark brown form of a lake at the right of the image. Orange cloud-like forms ripple in the sky overhead.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Bear Lake, 1931","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Bear Lake, 1931. Oil on canvas, 15 15/16 x 35 13/16 inches. New Mexico Museum of Art. Gift of the Museum of New Mexico Foundation in honor of the New Mexico Museum of Art's Centennial year, 2017. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(An American Place, New York, N.Y.) \nFrank E. Karelson, New York, N.Y., 1932 \nNew York University, New York, N.Y., bequest, 1983 \n(Owings-Dewey Fine Art, Santa Fe, New Mexico) \n(Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"15 15/16 x 35 13/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"New Mexico Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 15 15/16 x 35 13/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of the Museum of New Mexico Foundation in honor of the New Mexico Museum of Art's Centennial year, 2017","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/885900/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/885900"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}