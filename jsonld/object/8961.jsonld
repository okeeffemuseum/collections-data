{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8961","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1040, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1040","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8961","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Black Hills with Cedar","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery label.","title":"Black Hills \u0026 Cedar, New Mexico","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery label.","title":"The Black Place – No. 3","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery label.","title":"Black Hills and Cedar","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Black Hills with Cedar","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Hirshhorn Museum and Sculpture Garden, Smithsonian Institution, Washington, DC, The Joseph H. Hirshhorn Bequest, 1981","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Black Hills with Cedar, 1942. Oil on canvas, 16 x 30 inches. Hirshhorn Museum and Sculpture Garden. Hirshhorn Museum and Sculpture Garden, Smithsonian Institution, Washington, DC, The Joseph H. Hirshhorn Bequest, 1981. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["Lynes date as 1942, Hirshhorn dates as 1941. (Source: Information provided for *Access O'Keeffe* by Hirshhorn Museum and Sculpture Garden, 2026)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive, Abiquiú Notebooks indicate, \"Painted in New York in 1942. . . Exam. at Amer. Place, March 1946 [note of backing inscriptions 1, 2]. Note: Miss O'Keeffe says this was painted in . . . New York in Jan. 1942.\" Backing inscriptions date 1941. Painted in New York and dated 1942 on basis of O'Keeffe letter: \"I painted that blank canvas you sent me with a few vague lines on it—it is one of the best—a little bunch of the green and blue cedar you sent me down in the front of it—The black place back of it\" (O'Keeffe to Maria Chabot, January 1942). Reproduced in *American Artist* (June 1943). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Black Hills with Cedar, 1942","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Downtown Gallery, New York \nForum Gallery, New York, to 16 May 1974 \nJoseph H. Hirshhorn, New York and Washington, DC, 16 May 1974-31 August 1981 \nEstate of Joseph H. Hirshhorn, 1981-1986 \nJoseph H. Hirshhorn Bequest, 1981 \n(Source: Hirshhorn Museum and Sculpture Garden, 2026)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 16 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Hirshhorn Museum and Sculpture Garden","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Two large, black hills with alternating black and tan strata loom over the composition. Smaller pink hills covered in crags flank the two larger formations. Two large, bright green sprigs of juniper and cedar hover at the bottom center of the canvas.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"16 x 30 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794780/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794780"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}