{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8721","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"660, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"660","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8721","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive.","title":"Gate of Adobe Church – New Mexico","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive. (Title used by Carnegie Museum of Art.)","title":"Gate of Adobe Church","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Abiquiú Notebooks.","title":"Gate of an Adobe Church, N.M.","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"selected-exhibition-titles":{"titles":["Gate of an Adobe Church\nEloquent Objects Georgia O'Keeffe and Still Life in New Mexico, 2015, Tacoma Art Museum (Tacoma)"],"type":"selected-exhibition-titles"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive.","title":"Gate of an Adobe Church, New Mexico","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Gate of an Adobe Church, New Mexico","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Gate of an Adobe Church, New Mexico, 1929","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Gate of an Adobe Church, New Mexico, 1929. Oil on canvas, 20 x 16 inches. Carnegie Museums of Pittsburgh. Purchased with funds provided by the Women's Committee and friends of Elisabeth Mellon Sellers in her memory. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Exam. at Amer. Place, April 1946 [notes backing inscription 2]. Not listed in catalogue.\" Exchanged in 1958 for cat. no. 1085. Pictured in 1931 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 47. On the checklist, Stieglitz listed three paintings as \"Ranchos Church\" and installation photographs include three church paintings, see Appendix III, figures 42, 47, 48. This painting, probably listed as \"Ranchos Church,\" is not Ranchos Church, but another unidentified New Mexico church. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 20 x 16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"20 x 16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Georgia O'Keeffe [1887-1986], 1929; The Downtown Gallery, New York, NY [1]; Private Collection, Woodbridge, CT (likely Morris Tyler [b. 1901?]), 1947 [2]; The Downtown Gallery, New York, NY; the artist, by exchange, 1958; Edith Gregor Halpert [1900-1970], New York, NY, by 1961 until October 6, 1970; estate of Edith Gregor Halpert, October 1970 until March 1973; estate sale, Sotheby Parke Bernet, New York, NY, March 14 to March 15, 1973, lot no. 25 [3]; Kennedy Galleries, New York, NY, 1973 until May 1974; purchased, with funds provided by the Women's Committee and friends of Elisabeth Mellon Sellers in her memory, by Museum of Art, Carnegie Institute, Pittsburgh, PA, May 1974 [4]. \n \nNotes: \n[1]. Provenance information is mainly from Barbara Buhler Lynes, \"Georgia O'Keeffe, Catalogue Raisonné, Volume One,\" National Gallery of Art, Washington DC, 1999. \n[2]. The collector is identified in the sales catalogue in note [3] below. \n[3]. Sale no. 3484 \"Highly Important 19th and 20th Century American Paintings, Drawings, Watercolors and Sculpture: From the Estate of the Late Edith Gregor Halpert.\"  This lot, illustrated in the catalogue, sold on March 15, 1973. \n[4]. The oil on canvas painting was received at the museum from Kennedy Galleries in New York City; it was accessioned on May 9, 1974. \n(Source: Carnegie Museums, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A tan adobe wall with a gate frames a dark brown cross at the center of the composition. Beyond the cross, an adobe church with a black and white doorway rises above the gate. A small white cross emerges from the roof of the church. In the background, brown hills are visible beneath a bright blue sky.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Purchased with funds provided by the Women's Committee and friends of Elisabeth Mellon Sellers in her memory","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Carnegie Museums of Pittsburgh","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/713897/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/713897"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}