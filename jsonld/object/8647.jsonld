{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8647","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8647","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"577","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"577, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive.","title":"Radiator Bldg – Night New York","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive.","title":"Radiator Bldg. Night – New York, N. Y.","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive.","title":"Radiator Building, Night – N.Y. City","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive.","title":"Radiator Building","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"(This title used by Crystal Bridges)","title":"Radiator Building – Night","type":"alternate-title-1999-catalogue-raisonne"},{"title":"Radiator Building – Night, New York","type":"alternate-title-1999-catalogue-raisonne"},{"title":"A Building, N.Y. – Night","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Abiquiú Notebooks.","title":"Radiator Bldg – Night, New York","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Radiator Bldg – Night, New York","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Crystal Bridges Museum of American Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Radiator Bldg – Night, New York, 1927","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Alfred Stieglitz Collection, Co-owned by Fisk University, Nashville, Tennessee, and Crystal Bridges Museum of American Art, Bentonville, Arkansas","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Infor. from Miss Bry (An Amer. Place), July 1949: On permanent loan to Fisk University, Nashville, Tennessee, from Georgia O'Keeffe as part of the Alfred Stieglitz Coll.\" Inscription 8 dates 1925. Inscription 10, Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks date 1927. Dated 1927 on basis of inclusion in 1928 New York (Intimate Gallery– O'Keeffe) exhibition. Titled *Radiator Building – Night /New York* by Stieglitz on Abiquiú Notebooks photograph; reproduced in *Art in America* (1929); reproduced and titled *The American Radiator Building at Night* in *New York Herald-Tribune* (December 1929); reproduced in *Outlook and Independent* (January 1930); reproduced as *New York's Black Tower* in *Fortune* (April 1935); reproduced in *Newsweek* (July 1944); titled *Radiator Building* in *The Philadelphia Museum Bulletin* (June 1945). See cat. no. 1894. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Artist; to Alfred Stieglitz (her husband); to Artist (his wife); to Fisk University, Nashville, TN, 1949; to Fisk University, Nashville, TN, and Crystal Bridges Museum of American Art, Bentonville, AR, as co-owners, 2012 (Source: Crystal Bridges, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Radiator Bldg – Night, New York, 1927. Oil on canvas, 48 x 30 inches. Crystal Bridges Museum of American Art. Alfred Stieglitz Collection, Co-owned by Fisk University, Nashville, Tennessee, and Crystal Bridges Museum of American Art, Bentonville, Arkansas. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A tall, black skyscraper rises dramatically into the night sky. Light shines from some of the windows in the building and other structures around it, creating a patchwork of black and white. At the top of one of the buildings, text rendered in red neon reads Alfred Stieglitz. Steam or smoke spreads across the deep blue sky, which is illuminated by the beams of unseen searchlights.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/869311/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/869311"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}