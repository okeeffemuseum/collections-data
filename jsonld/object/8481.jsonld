{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8481","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"385","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8481","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"385, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"A Storm","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"A Storm","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Pastel on paper, mounted on illustration board","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Pastel on paper, mounted on illustration board, 18 1/4 x 24 3/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Anonymous gift, 1981","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Pastel on moderately thick, white, slightly textured laid paper mounted to gray cardboard, illustration board* \nWatermark: Blind stamp at corner, STRATHMORE with thistle","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive, Abiquiú Notebooks indicate, \"Exam. at American Place, March 1946. . . . On backing: In pencil by O'Keeffe 'A Storm'/22\" [not verified]. Whitney Archive indicates, \"No signature. See gallery photograph 2–d.\" Abiquiú Notebooks indicates, \"Back: OK initials and star\" [not verified]. Abiquiú Notebooks after 1977 indicates, \"Sold by Halpert . . . Nov, 1960.\" Pictured in 1923 New York (Anderson) Stieglitz installation photograph, see Appendix III, figure 13. Mentioned in 1934 New York (An American Place) exhibition review in *New York Times* (1934). See cat. nos. 381–84, 386, 387. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"A Storm, 1922","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Metropolitan Museum of Art (The Met)","type":"LinguisticObject"},{"classified_as":[{"_label":"selected_references","id":"https://data.okeeffemuseum.org/terms/local/selected_references"}],"content":"Edward Alden Jewell. \"Georgia O'Keeffe in an Art Review.\" New York Times (February 2, 1934), p. 15. \n \nE [dward]. A [lden]. J [ewell]. \"O'Keeffe, Kuhn, Lintott.\" New York Times (February 4, 1934), p. X12. \n \nLisa M. Messinger in \"Twentieth Century Art.\" The Metropolitan Museum of Art: Notable Acquisitions, 1980–1981. New York, 1981, p. 66, ill. (color). \n \nLisa Mintz Messinger. \"Georgia O'Keeffe.\" Metropolitan Museum of Art Bulletin 42 (Fall 1984), pp. 14, 18, fig. 15 (color). \n \nPhilippe de Montebello. \"[Director's Note].\" Metropolitan Museum of Art Bulletin 42 (Fall 1984), p. 2. \n \nKay Larson. \"The Met Goes Modern: Bill Lieberman's Brave New Wing.\" New York Magazine 19 (December 15, 1986), ill. p. 45 (color). \n \nLisa Mintz Messinger. Georgia O'Keeffe. New York, 1988, pp. 24–25, 90, fig. 15 (color). \n \nMary Wayne Fritzsche in American Pastels in the Metropolitan Museum of Art. Exh. cat., The Metropolitan Museum of Art. New York, 1989, pp. 131–33, ill. pp. 130 (color), 204. \n \nMarjorie Shelley in American Pastels in The Metropolitan Museum of Art. Exh. cat., The Metropolitan Museum of Art. New York, 1989, p. 40. \n \nMary Wayne Fritzsche and Gail Stavitsky in American Pastels in The Metropolitan Museum of Art. Exh. cat., The Metropolitan Museum of Art. New York, 1989, p. 25. \n \nElizabeth Montgomery. Georgia O'Keeffe. New York, 1993, ill. pp. 68–69 (color). \n \nBarbara Buhler Lynes. Georgia O'Keeffe: Catalogue Raisonné. New Haven, Conn., 1999, vol. 1, p. 208, no. 385, ill. (color); vol. 2, p. 1112, fig. 13 (installation photo of Exh. New York 1923). \n \nSamantha Friedman. Georgia O'Keeffe: To See Takes Time. Exh. cat., Museum of Modern Art, New York. New York, 2023, pp. 25, 119, 171, fig. 17 (installation photo, Exh. New York 1923), colorpl. 87. \n \nLaura Neufeld in Samantha Friedman. Georgia O'Keeffe: To See Takes Time. Exh. cat., Museum of Modern Art, New York. New York, 2023, p. 36.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"18 1/4 x 24 3/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"[Downtown Gallery, New York, until 1960; stock no. 248; sold on November 1, 1960 to private collection]; private collection, Wilmington, Del. (1960–at least 1961); [Robert Miller Gallery, New York, until 1980; sold in 1980 to private collection]; private collection (1980–81; their gift to MMA) (Source: The Met, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. A Storm, 1922. Pastel on paper, mounted on illustration board, 18 1/4 x 24 3/8 inches. Metropolitan Museum of Art (The Met). Anonymous gift, 1981. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Lightning emerging from a dark cloud shoots down the center of the composition. The lightning illuminates a dark sky and strip of land or sea below. Two semicircles of white light emanate from the two bottom corners of the image.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/884930/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/884930"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}