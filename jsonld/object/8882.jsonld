{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8882","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"913, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8882","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"913","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"The House I Live In","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery label.","title":"O'Keeffe Studio","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery label.","title":"House I Live In","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks, 1937–38 New York (An American Place) exhibition checklist.","title":"The House I Live In","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"The House I Live In, 1937","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A low, reddish-brown adobe house with white-trimmed windows stretches across the composition. The house stands on an expanse of green earth, and the blue form of Pedernal rises in the distance behind it. A blue sky with a few wispy clouds fills the top of the image.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Yale University Art Gallery, Transferred from the Beinecke Rare Book and Manuscript Library, Donald Clifford Gallup Papers, Yale Collection of American Literature","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Yale University Art Gallery","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"14 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The artist, New York, then Abiquiu, N. Mex.; Downtown Gallery (Edith Halpert, dealer), New York, by February 1953 [see note 1]; transferred to Doris Bry (1920–2014, dealer), New York, about 1963 [see note 2]; sold through Doris Bry (1920–2014, dealer), New York, to Donald Clifford Gallup (1913–2000), New Haven, Conn., 1967 [see note 3];  bequeathed to the Beinecke Rare Book and Manuscript Library, Yale University, New Haven, Conn., 2001; transferred to the Yale University Art Gallery, New Haven, Conn., 2019 \nNote 1: In 1953, the painting was on loan from the Downtown Gallery to the Dallas Museum of Art. The Downtown Gallery had exclusive representation of the artist between 1950–1963. \nNote 2: Doris Bry took over exclusive representation of the artist from Downtown Gallery by 1963. (Jo Ann Lewis, “Doris Bry The Legend of O’Keeffe,” Washington Post, January 7, 1990; “Timeline,” https://www.okeeffemuseum.org/timeline/, accessed September 29, 2025). \nNote 3: Correspondence between Gallup, the artist and Bry, indicates that the painting was sold to Gallup through Bry on behalf of the artist (Gallup correspondence, November 3, 1966–February 18, 1969, Donald Clifford Gallup Papers, Beinecke Rare Books and Manuscripts Library, YCAL MSS 838, accession 14, Box 50, copies in accession file) \n(Source: Yale University Art Gallery, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Painted 1937. See gallery photograph [not verified].\" Reproduced untitled in *Life* (February 1938). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. The House I Live In, 1937. Oil on canvas, 14 x 30 inches. Yale University Art Gallery. Yale University Art Gallery, Transferred from the Beinecke Rare Book and Manuscript Library, Donald Clifford Gallup Papers, Yale Collection of American Literature. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 14 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/714033/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/714033"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}