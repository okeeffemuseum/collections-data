"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Collection of the New Mexico Museum of Art. Gift of the Georgia O’Keeffe Estate, 1987 (1987.312.1)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"The smooth, pale blue form of the Chama River rushes through the center of the composition, flanked by vibrant green banks. Tan hills dotted with green bushes rise from the banks. A blue mountain is visible in the distance, stretching out below a strip of pale white sky.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Artist until her death in 1986; gift of the Estate to the New Mexico Museum of Art in 1987. \n(Source: New Mexico Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© New Mexico Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Double entries Abiquiú Notebooks. Not recorded Whitney Archive, Downtown Gallery Archive. Abiquiú Notebooks dates 1934. Abiquiú Notebooks after 1977 dates 1935. Dated 1937 on basis of inclusion in 1937–38 New York (An American Place) exhibition and Stieglitz–O'Keeffe correspondence. See cat. nos. 851, 1987, 1990, 1991, 2017–20. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"30 1/4 x 16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"New Mexico Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Chama River, Ghost Ranch, 1937","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 30 1/4 x 16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Chama River, Ghost Ranch, 1937. Oil on canvas, 30 1/4 x 16 inches. New Mexico Museum of Art. Collection of the New Mexico Museum of Art. Gift of the Georgia O’Keeffe Estate, 1987 (1987.312.1). © New Mexico Museum of Art","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/714041/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/714041"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}