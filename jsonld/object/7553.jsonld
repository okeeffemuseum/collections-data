/data.okeeffemuseum.org/terms/caption_complete"}],"content":"Saks Fifth Avenue. Purse, ca. 1930–1980. Leather and metal, 12 1/8 H x 15 1/2 L x 3 1/4 inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.3.440]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Purse, ca. 1930–1980","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Leather and metal, 12 1/8 H x 15 1/2 L x 3 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Black SAKS FITH AVENUE purse with two short leather flat looped handles at top. One side seems to have two outer pockets, but only one opens and has another zippered pocket inside. The other side has one pocket. One pocket in middle with main zipper and four zippered pockets inside. SAKS Label. 4 gold round feet on bottom. Main zipper says \"Talon\".  New York?","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779882/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779882"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}