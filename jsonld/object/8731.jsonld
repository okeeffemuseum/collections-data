{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8731","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"675, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"675","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8731","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Yellow Cactus","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"","title":"Yellow Cactus Flower","type":"alternate-title-1999-catalogue-raisonne"},{"title":"Two Yellow Flowers, N.M.","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive, Abiquiú Notebooks.","title":"Yellow Cactus","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Yellow Cactus, 1929. Oil on canvas, 30 x 42 inches. Dallas Museum of Art. Dallas Museum of Art, the Patsy Lacy Griffith Collection, bequest of Patsy Lacy Griffith. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Two bright yellow cactus flowers with delicate, rippling petals fill the frame. The petals fade from bright yellow at the center to almost white at their edges. White and gray tones fill the plain background.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"30 x 42 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Dallas Museum of Art, the Patsy Lacy Griffith Collection, bequest of Patsy Lacy Griffith","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive. Pictured in 1930 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 35. Orientation based on installation photograph. Abiquiú Notebooks does not specify orientation. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Yellow Cactus, 1929","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"1929-1953: Collection of the Artist, Abiquiu, NM \n1953: with The Downtown Gallery, New York, NY \n1960: William E. Scott (1899-1961), Fort Worth, TX, purchased from above \n1961 - 1963: William E Scott Foundation, Fort Worth, TX, by bequest from above upon the death of above \n1963-1989: Fort Worth Art Museum, Fort Worth, TX, gift from above [1] \n1989: Deaccessioned by above and sold at Sotheby's Sale (#5860), American Paintings, Drawings, and Sculpture Sale, 24 May 1989, lot 21, sold for $1,320,000 USD Premium \n1989-1993: With Hirschl \u0026 Adler, New York, NY, purchased from above sale, Stock book #APG7333 [2] \n1993: Patsy Lacy Griffith (1922-2000), Dallas, TX, purchased from above [3], [4] \n1998: Dallas Museum of Art, by bequest from above. \n \nNotes: \n[1] Old label affixed to backing board shows when held in the collection of the Fort Worth Art Museum, the accession number was 1963.7.9.G.P. In 1987 the Fort Worth Art Museum changed their name to The Modern Art Museum of Fort Worth \n[2] based on old label affixed to backing board \n[3] Based on a sale document in the Dallas Museum of Art object file from Hirschl \u0026 Adler dated December 22, 1993. \n[4] On December 16, 1998, Patsy Lacy Griffith gave 46% of an undivided interest in the painting to the Dallas Museum of Art. Her will gave the remaining 52% undivided interest to the DMA (Dallas Museum of Art) upon her death. \n(Source: Dallas Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 30 x 42 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Dallas Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863439/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863439"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}