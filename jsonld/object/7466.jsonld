{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/7466","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2016.2.40","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"7466","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Interior Court","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Myron Wood","id":"actor/11","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"8 7/8 x 13 7/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Interior Court, Apr 1980, 1984","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Exterior view of interior courtyard at O'Keeffe's Abiquiu house; adobe textured walls, wooden plank door with walking stick leaning on it, wellhead with circular wooden plank cover, flagstone or large bricks creating a horizontal pathway running in front of door and behind wellhead; abstract view of the courtyard accentuating the flatness of the geometric shapes -  the wooden door juxtaposed to the adobe wall, the circular 3-dimensional wellhead casting a shadow in the foreground, the leaning stick, the flagstones and the beauty of the dirt on which all the planes and shapes intersect and sit.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id"