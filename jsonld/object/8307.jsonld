icObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Harold Diamond, New York, NY, purchase, 1976; (Doris Bry, New York, NY) (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Watercolor and graphite on moderately thick, cream, slightly textured wove paper\n(Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Museum of Modern Art (MoMA)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Train at Night in the Desert, 1916","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"11 7/8 x 8 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Billows of white and yellow smoke escape from a black and blue teardrop form at the left of the composition. The form, which resembles a far-off train, also has a point of yellow and white light at its center. A curving form emerges from the base of this train. The background of the work is a gradient that transitions from light gray at the bottom of the paper to black at the top.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Train at Night in the Desert, 1916. Watercolor and graphite on paper, 11 7/8 x 8 7/8 inches. Museum of Modern Art (MoMA). © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Watercolor and graphite on paper, 11 7/8 x 8 7/8 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863552/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863552"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}