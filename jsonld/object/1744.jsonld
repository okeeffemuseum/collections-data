{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300266639","label":"clothing","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/1744","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"1744","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2000.3.348","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Coat","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Knize","id":"actor/1029","type":"Actor"},{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Knize. Coat, 1955. Wool, 47 1/4 x 37 1/4 inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.3.348]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Wool","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Knize","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Wool, 47 1/4 x 37 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Coat, Black \"KNIZE\", \"Tailored Shirtmaker\", 3 scalloped pockets with double flaps. Shawl collar . Heavy wool twill. Handkerchief in breast pocket \"Tailor \u0026 Shirtmaker.  Label back of neck \" Knize New York; London \u0026 Paris. Inside proper Left pocket \"Knize inc. New York, Paris, Vienna\" 7/477 MS. G. O'Keeffe. 3/22/55.  Same date as 0382 pants, different fabric. Five circular plastic buttons on the front; two buttons on each cuff, rounded collar; tapered waist; double scalloped waist pockets; black lining inside coat.  Vienna? Rectangular black tag, in the center rear of the collar, ovular white logo \"Knize Taylor shirt maker, New York. London, Paris, Vienna\". Inside right front pocket, rectangular white label with black print Knize logo, printed in grey ink. \"9/477 Ms. G. O'Keeffe 3/22/55\".","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Coat, 1955","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"47 1/4  x 37 1/4 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/780189/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/780189"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://i