{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8568","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8568","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"483, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"483","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"New York Street with Moon","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"New York Street with Moon","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["Lynes, 1999 lists medium of this work as oil on canvas, mounted to masonite. Thyssen-Bornemisza lists it as oil on canvas. (Source: Information provided for *Access O'Keeffe* by Museo National Thyssen-Bornemisza, 2026)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"New York Street with Moon, 1925","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Colección Carmen Thyssen","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive, Abiquiú Notebooks indicate, \"Exam. at Amer. Place, April 1946. . . . Information from O'Keeffe: Bought by Mrs. Adolph Meyer from 1926 exhibition. First N.Y. Street \u0026 painted 1925. Title given by O'Keeffe, 'New York Street with Moon.' Still owned by Mrs. Meyer. Sent in to Amer. Place for cleaning.\" Abiquiú Notebooks indicates, \"Reframed at An American Place in 1948.\" O'Keeffe wrote: \". . . I was looking for a place to live, I decided to try the Shelton. I was shown two rooms on the 30th floor. I had never lived up so high before and was so excited that I began talking about trying to paint New York. Of course, I was told that it was an impossible idea––even the men hadn't done too well with it. . . . My first painting was a night scene of 47th Street, *New York with Moon*. There was a street light in the upper foreground at about the Chatham Hotel\" (*Georgia O'Keeffe* [1976], unpaginated, text accompanying entry 17). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. New York Street with Moon, 1925. Oil on canvas, 48 x 30 inches. Museo Nacional Thyssen-Bornemisza. Colección Carmen Thyssen. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A dark brown building, seen from street level, juts out against a cloudy sky that fades from orange at the bottom of the composition to dark blue at the top. A full moon peeks halfway out from behind the rippling clouds. A dark lamppost with a glowing streetlight and a red traffic light sits in front of the building. Other buildings are visible along the street, overlapping with the sky.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Museo Nacional Thyssen-Bornemisza","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"[The Intimate Gallery], NewYork. \nMr. and Mrs. Adolph Meyer, New York, 1926 (still in Mrs. Meyer's possession in 1946). \nMr. and Mrs. Peter Meyer, Scarsdale, New York, from 1960 until 1976. \nArcadia Inc., Washington (DC). \nThyssen-Bornemisza Collection, Lugano, 1981. \nCarmen Thyssen-Bornemisza Collection on loan to the Thyssen-Bornemisza Museum, Madrid. (Source: Museo Thyssen-Bornemisza, 2026)","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/873018/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/873018"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}