{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/6648","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"6648","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2014.3.99","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Maria, Bernie, Little Max, The Gato, and Georgia O'Keeffe","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/300","type":"Actor"},{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Maria, Bernie, Little Max, The Gato, and Georgia O'Keeffe, 1941","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Museum Purchase","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Group portrait of O'Keeffe holding a Siamese cat standing next to two young adult  women and a baby; the women are identified as Maria and Bernie, and the baby as Little Max; O'Keeffe is wearing a collared long sleeve shirt with her sleeves rolled up and  jeans; she has a large bandage wrapped around the wrist of her left hand which she uses to hold and cradle the neck of the cat; she looks at the camera with a big grin, her long hair falls on her shoulder and is combed away from her face; Bernie holds baby Max who is dressed in white and wrapped in a white blanket; a stuffed black bird with extended wings is mounted on the adobe wall or the portal, three vigas can be seen at the top of the photograph.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"9 5/8 x 7 1/2 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Gelatin silver print","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Unknown. Maria, Bernie, Little Max, The Gato, and Georgia O'Keeffe, 1941. Gelatin silver print, 9 5/8 x 7 1/2 inches. Georgia O'Keeffe Museum. Museum Purchase. © Unknown. [2014.3.99]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Gelatin silver print, 9 5/8 x 7 1/2 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799546/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799546"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationOb