"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Green Mountains, Canada, 1932","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Georgia O’Keeffe (1887–1986), New York and New Mexico, then Abiquiú, NM, from 1949 [on loan to the Art Institute of Chicago from 1949; letter from O’Keeffe to Daniel Catton Rich, Mar. 15, 1957; copy in curatorial object file]; given through the Alfred Stieglitz Collection to the Art Institute of Chicago, 1956. (Source: Art Institute of Chicago, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Tall green mountains rise in the center of this landscape painting. The softly rippling mountains emerge from a flat landscape, with a strip of blue water in the foreground. Undulating white clouds stretch out above the peaks.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Alfred Stieglitz Collection, gift of Georgia O'Keeffe, 1956.365","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Art Institute of Chicago","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 12 x 36 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"12 x 36 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Art Institute of Chicago","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Green Mountains, Canada, 1932. Oil on canvas, 12 x 36 inches. Art Institute of Chicago. Alfred Stieglitz Collection, gift of Georgia O'Keeffe, 1956.365. © Art Institute of Chicago","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Knight Pub. O'Keeffe, 1937. Color Plate. No. 3 .. . Infor. from Miss Bry (An Amer. Place), July 1949: On permanent loan to the AIC from Georgia O'Keeffe as part of the Alfred Stieglitz Coll.\" Pictured in 1933 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 55. Reproduced in *Creative Art* (April 1933). (Source: Lynes, 1999)"],"type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/871283/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/871283"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}