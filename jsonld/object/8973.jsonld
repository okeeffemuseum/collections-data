/aat/300026687"}],"content":"Gift of Richard Toscan and Sharon Walker","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Georgia O'Keeffe, 1971","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Basil Langton. Georgia O'Keeffe, 1971. Gelatin silver print, 13 7/8 x 10 15/16 inches. Georgia O'Keeffe Museum. Gift of Richard Toscan and Sharon Walker. © Basil Langton. [2015.7.1]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Quarter length portrait of Georgia O'Keeffe wearing a dark  patterned Marimekko dress with her head turned towards the the camera; her body is in profile and her face is turned to viewer right; her hair is pulled back into a bun on her head, she appears to be wearing one of her white wrap dresses underneath the Marimekko dress; the background is a blur of stacked boxes (?).","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857307/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857307"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}