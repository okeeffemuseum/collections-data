"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Portrait of Georgia O'Keeffe standing in front of pile of stacked firewood;  three-quarter length view, head turned slightly to viewer right  with eyes looking down, hair pulled back from face into a bun, hands clasped together below waist, collared long-sleeve buttoned jacket with pockets worn over blouse and skirt; all garments similarly colored, Alexander Calder brooch on viewer right lapel. Upper half of photo uneven tonal range.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Museum Purchase","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Carl Van Vechten. Georgia O'Keeffe, Abiquiu, Aug 16 1950. Gelatin silver print, 9 3/8 x 7 3/8 inches. Georgia O'Keeffe Museum. Museum Purchase. © The Van Vechten Trust. [2014.3.141]","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"9 3/8 x 7 3/8 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799538/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799538"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}