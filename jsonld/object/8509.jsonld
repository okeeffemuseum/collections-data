{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8509","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"415","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8509","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"415, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"","title":"Alligator Pear – No. 11","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Alligator Pears","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Alligator Pears","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Alligator Pears, 1923","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Alfred Stieglitz, New York, NY); Paul Strand, New York, NY, 1920s; Estate of Paul Strand, 1976; (Zabriskie Gallery, New York, NY) (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A crinkled piece of white fabric or paper wraps around a dark green avocado. The items in the image are highly simplified, appearing as shapes and colors rather than recognizable objects.","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Pastel on medium thick, beige, moderately textured wove paper mounted to gray cardboard, illustration board\n(Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Alligator Pears, 1923. Pastel on paper mounted to cardboard, illustration board*, 12 x 10 inches. Private Collection. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Pastel on paper mounted to cardboard, illustration board*","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Sold to Paul Strand. Note: Did not see at Strand's apt. in the fall of 1945 as it was being reframed.\" Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks date 1923. Backing dates 1924. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"12 x 10 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Pastel on paper mounted to cardboard, illustration board*, 12 x 10 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824299/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824299"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}