{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8823","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"822, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"822","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8823","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Barn with Snow","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"","title":"Barn – Lake George – Winter","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: backing inscription 1, Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Barn with Snow","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 16 x 28 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The Downtown Gallery, Inc., New York, New York ( - ) \nThe Downtown Gallery, Inc., New York, New York ( - 1960) \nGeorgia O'Keeffe, New York, New York (1934 - ) \nH. R. Aldredge, Dallas, Texas (1952 - ) \nMr. and Mrs. James S. Snowden, Fort Worth Texas (1960 - ca. 1966) \nMrs. Frederick M. Lege, III, Washington, D.C. (1966 - ) \nDoris Bry, New York, New York (1966 - 1967) \nGeorgia O'Keeffe, New York, New York (1967 - ca. 1969) \nDoris Bry, New York, New York (1969 - 1969) \nSidney and George Perutz, Dallas, Texas (1969 - 1971) \nMr. and Mrs. Norton S. Walbridge, La Jolla, California (1971 - January 14, 1977) \nSan Diego Museum of Art, San Diego, California (January 14, 1977 - ) \n(Source: SDMA website, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Barn with Snow, 1934","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"16 x 28 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Not listed in 1935 exhibition so this [New York (An American Place – O'Keeffe) 1937] must be first time shown. Exam. at Amer. Place, March, 1946\" [notes inscription 1]. Abiquiú Notebooks indicates, \"Note: From exhibition 1934 folder 'Barn in Snow, 1933.' May be misdated.\" Backing inscriptions date 1933. Whitney Archive, Abiquiú Notebooks date 1934. Downtown Gallery Archive dates 1933. Dated 1934 on basis of Stieglitz–O'Keeffe correspondence. Due to illness, O'Keeffe did not paint from late fall 1932 until January 1934, when she completed this work. She wrote: \"There was a fine old barn at the Lake George farmhouse. . . . I have looked at the barn in summer and have looked at it in the winter when the snow was deep\" (*Georgia O'Keeffe* [1976], unpaginated, text accompanying entry 44). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Barn with Snow, 1934. Oil on canvas, 16 x 28 inches. San Diego Museum of Art. San Diego Museum of Art, Gift of Mr. and Mrs. Norton S. Walbridge (1976.215). © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"San Diego Museum of Art, Gift of Mr. and Mrs. Norton S. Walbridge (1976.215)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A gray and red barn with a pitched, snow-covered roof stands on a stretch of snowy earth. A gray and white sky stretches overhead.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"San Diego Museum of Art","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794116/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794116"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}