{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/3869","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"3869","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2014.1.1","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Hopi Montage #11","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Dan Namingha","id":"actor/815","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Margaret Velie Kinney","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Hopi Montage #11, 1997","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Acrylic on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Dan Namingha","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Painting, Acrylic on canvas. Using a horizontal format segmented in three parts depicting on the left a Kachina against a neutral background of biege complemented by a stand of delineated cactus-like forms. At the center, irregular and geometric cultural symbols are set against a mottled background in pink, dissolving at the left into transparent bands of light green and pink against a beige background and held visually in place by a gray-black horizontal band. The center is partitioned from both sides of he composition with a vertical band in light blue on the left and a black and white band on the right. The right portion of the composition depicts a Kachina, similar in size and posture to the figure on the left side. but now in grays and black against a vivid mottled background of red, orange and salmon colors with circular symbols at each side.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"16 x 84 x 1 3/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Dan Namingha","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Acrylic on canvas, 16 x 84 x 1 3/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Dan Namingha. Hopi Montage #11, 1997. Acrylic on canvas, 16 x 84 x 1 3/4 inches. Georgia O'Keeffe Museum. Gift of Margaret Velie Kinney. © Dan Namingha. [2014.1.1]","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}