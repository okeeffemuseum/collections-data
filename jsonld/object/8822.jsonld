{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033973","label":"drawings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8822","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"821","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8822","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"821, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Special No. 40","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive.","title":"A Drawing","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive.","title":"Special #40","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Abiquiú Notebooks, which indicate lost inscription on original backing, \"On backing: 'Special No. 40 1935.'\" Whitney Archive indicates, \"Exam. at Amer. Place, March 1946. . . . No signature. . . . This is probably the drawing #24 in O'Keeffe exh. at American Place Jan.–Mar. 1935, which is dated 1934.\"","title":"Special No. 40","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Special No. 40, 1934. Graphite on wove paper, 16 1/8 x 11 inches. Philadelphia Museum of Art. 125th Anniversary Acquisition. Purchased with the gift (by exchange) of Dr. and Mrs. Paul Todd Makler, funds contributed by Barbara Rothschild Michaels, The Herbert \u0026 Nannette Rothschild Memorial Fund in memory of Judith Rothschild, Mr. and Mrs. W. B. Dixon Stroud, and gift of The Georgia O'Keeffe Foundation, 1997. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Graphite on moderately thick, white, slightly textured wove paper\n(Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Softly drawn, rippling forms occupy the center of the work. The delicately shaded shapes resemble ripples of fabric and are just barely visible on the exposed surface of the paper.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"125th Anniversary Acquisition. Purchased with the gift (by exchange) of Dr. and Mrs. Paul Todd Makler, funds contributed by Barbara Rothschild Michaels, The Herbert \u0026 Nannette Rothschild Memorial Fund in memory of Judith Rothschild, Mr. and Mrs. W. B. Dixon Stroud, and gift of The Georgia O'Keeffe Foundation, 1997","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"16 1/8 x 11 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Graphite on wove paper","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Graphite on wove paper, 16 1/8 x 11 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Philadelphia Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Special No. 40, 1934","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Double entries Downtown Gallery Archive. Abiquiú Notebooks indicates, \"Back: OK initials and star\" [not verified]. O'Keeffe wrote: \"This is from the sea—a shell—and paintings followed [see cat. no. 847]\" (*Some Memories of Drawings* [1988], unpaginated). Whitney Archive dates 1934? Abiquiú Notebooks dates 1934. Downtown Gallery Archive dates 1934 and 1935. Dated 1934 on basis of inclusion in 1935 New York (An American Place) exhibition. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"125th Anniversary Acquisition. Purchased with the gift (by exchange) of Dr. and Mrs. Paul Todd Makler, with funds contributed by Barbara Rothschild Michaels, The Herbert \u0026 Nannette Rothschild Memorial Fund in memory of Judith Rothschild, Mr. and Mrs. W. B. Dixon Stroud, and gift of The Georgia O'Keeffe Foundation, 1997  \n(Source: Philadelphia Museum of Art, 2025)","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857727/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857727"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}