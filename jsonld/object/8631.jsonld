,"id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Black Petunia and White Morning Glory II, 1926","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Sold to Elizabeth Arden.\" Titled *Petunia \u0026 Morning Glory* by Stieglitz on Abiquiú Notebooks photograph; reproduced and titled *Black and White Flowers No. 2* in *Creative Art* (January 1928). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Black Petunia and White Morning Glory II, 1926. Oil on canvas, 36 x 30 inches. Private Collection. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"36 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 36 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Two petunias, a white one on the left and a deep purple on the right, dominate the composition. Hints of pale pink appear on the velvety petals of both flowers. The blooms sit against a textured, white and gray background.","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(An American Place, New York, NY); Elizabeth Arden, New York, NY, 1933; Patricia Graham Young, New York, NY, bequest, by 1986; Estate of Patricia Graham Young, 1990; Sotheby's, New York, NY, sale no. 6025, lot no. 220, 24 May 1990 (Source: Lynes, 1999)","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824385/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824385"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}