{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8897","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8897","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"937, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"937","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Gerald's Tree II","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks, 1937–38 New York (An American Place) exhibition checklist.","title":"Gerald's Tree II","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Purchase of the Nelda C. and H.J. Lutcher Stark Foundation, 1987","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A short, bare tree with twisting limbs stands on a stretch of red earth. Green bushes grow on the land, and a few tall, craggy red hills rise in the background.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Gerald's Tree II, 1937. Oil on canvas, 40 x 30 inches. Stark Museum of Art. Purchase of the Nelda C. and H.J. Lutcher Stark Foundation, 1987. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"40 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Exam. at Amer. Place, April 1946. . . . Nothing on backing. Pntd. 1937. See gallery photograph\" [not verified]. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Gerald's Tree II, 1937","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 40 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Georgia O'Keeffe, 1937-1971; purchased 1971 by Doris Bry, New York, New York; David Suskind, New York, New York, 1971-1986; (Hirschl \u0026 Adler Galleries, Inc., New York, New York); purchased January 13, 1987 by Nelda C. and H.J. Lutcher Stark Foundation; accessioned to the Stark Museum of Art (Source: Stark Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Stark Museum of Art","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863585/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/863585"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}