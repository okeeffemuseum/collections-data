{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300078925","label":"watercolors (paintings)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/988","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"127","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"988","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.5.40","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"127, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery label.","title":"Morning Sky with Houses #2","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"selected-exhibition-titles":{"titles":["Morning Sky with Houses II\nAn Expanding Collection, 1998, Georgia O'Keeffe Museum (Santa Fe)"],"type":"selected-exhibition-titles"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive, Abiquiú Notebooks.","title":"Morning Sky with Houses","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Morning Sky with Houses","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(The Downtown Gallery, New York, N.Y.) \nPrivate collection, Bronxville, N.Y., 1958 \nSotheby Parke Bernet Inc., New York, N.Y., sale no. 3585, \nlot no. 64, 13 December 1973 \nThe artist, 1973 \nEstate of the artist, 1986 \nGeorgia O’Keeffe Foundation, 1993 \nGift to Georgia O’Keeffe Museum, 2006 \n(Source: Georgia O'Keeffe Museum, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Watercolor and graphite on moderately thick, cream, smooth wove paper with a slightly fuzzy feel\n(Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Watercolor and graphite on paper","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Morning Sky with Houses, 1916. Watercolor and graphite on paper, 8 7/8 x 12 inches. Georgia O'Keeffe Museum. Gift of The Georgia O'Keeffe Foundation. © Georgia O'Keeffe Museum. [2006.5.40]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Morning Sky with Houses, 1916","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"The silhouettes of two houses are visible in an early morning landscape.  The first house, located in the center of the work, is  larger than the second house, which is situated on the right side of the piece.  The horizon line distinguishes the dark earth from the sky and lies approximately one-third of the distance from the top edge of the paper.  The sky is brightly colored near the horizon; however, it darkens as it ascends into the clouds.","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive. Completed after August move to Texas. See cat. no. 126. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of The Georgia O'Keeffe Foundation","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Watercolor and graphite on paper, 8 7/8 x 12 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"8 7/8 x 12 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/789914/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/789914"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}