Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on board, 17 3/8 x 13 1/2 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on board","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Milwaukee Art Museum, Gift of Jane Bradley Pettit Foundation and the Georgia O'Keeffe Foundation M1997.190","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"[1] Estate of the artist [1887–1986] (Santa Fe, New Mexico, USA); [2] 1993, Georgia O'Keeffe Foundation (Abiquiu, New Mexico, USA); [3] December 26, 1997, purchased by Jane Bradley Pettit Foundation (Milwaukee, Wisconsin, USA) and gift to Milwaukee Art Museum (Milwaukee, Wisconsin, USA) \nNOTES: \n[1], [2] Barbara Buhler Lynes, Georgia O'Keeffe: Catalogue Raisonné. Vol. 1 (New Haven, CT: Yale University Press; Washington, DC: National Gallery of Art; Abiquiu, NM: The Georgia O'Keeffe Foundation, 1999), p. 97, cat. 156. \n[3] Agreement in MAM object file \n(Source: MAM, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["Date listed as 1916/1917 in the Lynes publication."],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. No. 20 – Special, 1916–1917. Oil on board, 17 3/8 x 13 1/2 inches. Milwaukee Art Museum. Milwaukee Art Museum, Gift of Jane Bradley Pettit Foundation and the Georgia O'Keeffe Foundation M1997.190. © Milwaukee Art Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Milwaukee Art Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Not recorded Whitney Archive, Downtown Gallery Archive. Verso inscription 1 and Abiquiú Notebooks date 1916. Completed after August move to Texas. Pictured in 1917 New York (291) Stieglitz installation photograph, see Appendix III, figure 9. See cat. nos. 135–55, 157–62. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"17 3/8 x 13 1/2 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862526/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862526"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}