ect"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Bequest of Mary Pick Hines, class of 1953","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Frances Lehman Loeb Art Center, Vassar College","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Untitled (Flower), ca. 1932. Oil on canvas, 12 1/4 x 9 inches. Frances Lehman Loeb Art Center, Vassar College. Bequest of Mary Pick Hines, class of 1953. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"An American Place, New York; \nAnn Morgan, New York, 1936; \nby gift to Malvina Hoffman, New York,1936; \nCharles Hoffman, New York, date unknown; \n(Andrew Crispo Gallery, Inc., New York); \nPrivate collection, New York, 1977; \nSotheby Parke Bernet Inc., New York, sale no. 4365, April 25, 1980, lot 249A; \nThe Regis Collection, Minneapolis, MN, 1980; \n(James Maroney, Inc., New York) 1981; \nChristie’s, New York, sale no. 6972, December 1, 1989, lot 204; \nBeltexsan Galleries, Fort Worth, TX, 1989; \nGerald Peters Gallery, Santa Fe, NM, 1990; \npurchased by Mary Pick Hines \n(Source: Frances Lehman Loeb Art Center, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 12 1/4 x 9 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/term