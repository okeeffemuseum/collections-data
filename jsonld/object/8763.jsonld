{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/8763","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"8763","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"719, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"719","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive.","title":"Jack-in-the-Pulpit","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Whitney Archive.","title":"Jack-in-the-Pulpit No. 5","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery Archive, Abiquiú Notebooks.","title":"Jack-in-the-Pulpit No. V","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"selected-exhibition-titles":{"titles":["Jack in the Pulpit No. V\nGeorgia O'Keeffe: The Poetry of Things, 1999, Georgia O'Keeffe Museum (Santa Fe)","Jack in the Pulpit No. V\nGeorgia O'Keeffe: The Poetry of Things, 1999, The Phillips Collection (Washington, D.C.)"],"type":"selected-exhibition-titles"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: backing inscription 1.","title":"Jack-in-Pulpit Abstraction – No. 5","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Jack-in-Pulpit Abstraction – No. 5","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"National Gallery of Art, Washington, Alfred Stieglitz Collection, Bequest of Georgia O'Keeffe, 1987.58.4","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Jack-in-Pulpit Abstraction – No. 5, 1930. Oil on canvas, 48 x 30 inches. National Gallery of Art (NGA). National Gallery of Art, Washington, Alfred Stieglitz Collection, Bequest of Georgia O'Keeffe, 1987.58.4. © Board of Trustees, National Gallery of Art, Washington","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Ptd. 1930.\" Series renumbered by O'Keeffe and Doris Bry in 1970. Pictured in 1931 and 1935 New York (An American Place) Stieglitz installation photographs, see Appendix III, figures 43, 59. Included in 1934 New York (An American Place) as indicated in *Newark Evening News* (1934). Titled *Jack–in–the–Pulpit (Abstraction)* by Stieglitz on Abiquiú Notebooks photograph; reproduced and titled *Jack–in–the–Pulpit #7* in *America \u0026 Alfred Stieglitz* (1934); reproduced in *American Painting Today* (1939). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Board of Trustees, National Gallery of Art, Washington","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Twisting, abstract maroon forms evoke the spathe and spadix of a jack-in-the-pulpit. The spathe-like form fills much of the canvas, curling in on itself to create a spiral pattern at the top of the image. Three spadix-like shapes stand one behind the other. The abstract plant form is framed by green, leaf-like shapes with streaks of pale blue.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"National Gallery of Art (NGA)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Jack-in-Pulpit Abstraction – No. 5, 1930","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The artist [1887-1986]; her estate; bequest 1987 to NGA. (Source: NGA, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 48 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857705/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857705"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}