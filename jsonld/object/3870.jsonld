ription"}],"content":"Polaroid print","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Polaroid print, 5 1/2 x 3 1/2 x 1 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"One Red Book consisting of Twenty One (21) Photographs with the Prefix F109.  Inventory Numbers: F109.00001 through F109.00021. (SEE MEDIA, MEASUREMENTS FOR INVENTORY).  Film Dates Dec-71. Media: Polacolor Type 108. Warhol's Little Red Books, consisting of myriad Polaroid photographs taken by Warhol and assembled by him into in a little red photo album. These works depict a wide array of subject, including many of the artist's well-known friends and associates.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"5 1/2 x 3 1/2 x 1 inches","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}