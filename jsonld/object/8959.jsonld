t"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A plant with green leaves and a bright red center extends over a plain white background. With its narrow green leaves encircling a red central flower, the plant resembles a bromeliad.","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Exam. at Amer. Place, March 1946. . . . No signature\" [notes backing inscription 2 but with date of 1942]. Abiquiú Notebooks indicates, \"Back: 1943?\" Backing inscription dates 1943. Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks date 1942. Dated 1942 on basis of inclusion in 1943 New York (An American Place) exhibition. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 40 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Doris Bry, New York, NY); Private collection, San Antonio, Texas, 1969 (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"40 x 