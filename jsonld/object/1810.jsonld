ed_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Black cotton smock w/grey cotton scalloped border at hem, button up front, 3/4  LS, \"Marimekko\" Buttons replaced? She added snap to keep it closed. 3 labels: 1: \"D/R New York Cambridge\" 2:\"© 1963 Marimekko (ay?)\" 3: Marimekko 100% cotton\" laundry label in proper left side seam. sw 5/13. Name of the dress Varjo (=Shadow), 1965 Pattern called Pilvi (=Cloud) by Annika Rimala, 1963  Finland (Suomi).","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Marimekko, Annika Rimala. Dress, Smock, 1963–1965. Cotton, 47 W x 48 L inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.3.420]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Marimekko, Annika Rimala","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779850/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779850"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779851/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digit