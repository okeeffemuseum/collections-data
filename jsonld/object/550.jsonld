{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/550","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"739, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"739","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"550","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Dark Mesa with Pink Sky","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Landscape Near H \u0026 M Ranch, Toward Abiquiú, N. M.","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Dark Mesa And Pink Sky","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: backing inscription.","title":"Dark Mesa with Pink Sky","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Amon Carter Museum of American Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Dark Mesa with Pink Sky, 1930","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Under a large, black mesa, red, orange, and white hills ripple across the canvas. The hills and mesa are smooth and have soft variations in tone and color. A thin strip of pale pink sky hangs above the landscape.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"16 x 29 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Amon Carter Museum of American Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 16 x 29 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Abiquiú Notebooks indicates, \"Back; OK initials and star. Back: O'Keeffe writing: \"Dark Mesa – Pink Sky – 30'\" [not verified]. Pictured in 1931 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 43. \"This is a very good one. The mountain is a very dark rich green— Hills have earth red in them—sky pale pink,\" written by O'Keeffe on photograph of work owned by The Georgia O'Keeffe Foundation (Now housed at the Georgia O'Keeffe Museum). See cat. no. 1902. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Dark Mesa with Pink Sky, 1930. Oil on canvas, 16 x 29 7/8 inches. Amon Carter Museum of American Art. © Amon Carter Museum of American Art","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857656/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857656"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}