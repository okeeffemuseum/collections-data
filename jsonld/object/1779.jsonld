{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300266639","label":"clothing","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/1779","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"1779","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2000.3.351a-b","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Dress (Top and Skirt)","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/300","type":"Actor"},{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Black silk faille 2 piece dress set; a: Vest top and b: Skirt.  a:  vest with spiral designed closures neck/ waist 6 gores well made no label. Center back and front panels slightly different weave than rest of jacket. 6 washers sewn into bottom lining of jacket for weight.  b: slightly flared gathered skirt; 6 gores waist/hem; weights at end of each skirt seam silk faille; no label; well made; front panels slightly different weave as well as central back panel from shirt and remainder of jacket. Weight also in vest. Spiral made of same materials. 6 washers sewn into bottom of skirt zipper on left hip. Note: spiral closures same material as jacket.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Dress (Top and Skirt), Late 1950s–Early 1960s","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Black silk faille","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Unknown. Dress (Top and Skirt), Late 1950s–Early 1960s. Black silk faille, Skirt: 31 L x 35 W inches ^Top: 21 L x 21 1/2 W inches ^ ^a: 20 1/4 W x 26 1/4 L inches ^b: 38 3/4 W x 31 1/2 L inches ^Size: custom. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.3.351a-b]","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"Skirt: 31 L x 35 W inches \nTop: 21 L x 21 1/2 W inches \n \na: 20 1/4 W x 26 1/4 L inches \nb: 38 3/4 W x 31 1/2 L inches \nSize: custom","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Black silk faille, Skirt: 31 L x 35 W inches ^Top: 21 L x 21 1/2 W inches ^ ^a: 20 1/4 W x 26 1/4 L inches ^b: 38 3/4 W x 31 1/2 L inches ^Size: custom","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/779738/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label"