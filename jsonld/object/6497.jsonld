e with 'Pelvis Series, Red with Yellow, 1960. Chromogenic print, 14 x 17 inches. Georgia O'Keeffe Museum. Museum Purchase. © Estate of Tony Vaccaro. [2007.3.1]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Portrait of O'Keeffe in a desert landscape standing in front of a white easel which holds her painting, \"Pelvis Series, Red with Yellow;\"  behind her is a blue sky with clouds and an outcropping of rocks;  she stands with her back to the camera and her head in profile, her hair is pulled back into a bun, her right arm  and hand supports the corner of the painting in viewer right and her left arm hangs at her side, she wears a black wrap dress and her favorite Hector Aguilar belt - a black suede and sterling silver Taxco belt from Mexico.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Chromogenic print, 14 x 17 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Chromogenic print","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Museum Purchase","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/729499/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/729499"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}