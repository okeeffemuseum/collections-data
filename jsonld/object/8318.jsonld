ype":"LinguisticObject"},{"classified_as":[{"_label":"selected_references","id":"https://data.okeeffemuseum.org/terms/local/selected_references"}],"content":"Carlson, Paul H. and John T. Becker. Georgia O'Keeffe in Texas: A Guide. Buffalo Gap, Texas: State House Press, 2012. \n \nCummins, Victoria H. and Light Townsend Cummins, eds. Making the Unknown Known: Women in Early Texas Art, 1860s-1960s. College Station: Texas A\u0026M University Press, 2022. (pending) \n \nCzestochowski, Joseph S., ed. Georgia O’Keeffe Visions of the Sublime. Memphis: Torch Press and International Arts, 2004. \n \nTyler, Ron, ed. The Art of Texas: 250 Years. Fort Worth: Texas Christian University Press, 2019. \n \nUdall, Sharyn Rohlfsen. O'Keeffe and Texas. New York: Harry N. Abrams, 1998.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862565/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/862565"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}