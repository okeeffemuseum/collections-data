{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300189621","label":"works on paper","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/10165","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1110","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"10165","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1110, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Goat's Horn With Red","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks, 1946 New York (An American Place) exhibition checklist.","title":"Goat's Horn With Red","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["Lynes publication lists medium as 'Pastel on paper laminated to cardboard', Hirshhorn refines medium listing as 'Pastel on paperboard mounted on paperboard'. (Source: Information provided for *Access O'Keeffe* by Hirshhorn Museum and Sculpture Garden, 2026)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Alfred Stieglitz, An American Place, New York \nDowntown Gallery, New York \nDr. and Mrs. Michael Watter, Philadelphia \nSotheby Parke Bernet Inc., New York, sale no. 2600, lot no. 42, 19 October 1967 \nJoseph Hirshhorn, New York, 19 October 1967-1972 \nGift of Joseph H. Hirshhorn, 1972 \n(Source: Hirshhorn Museum and Sculpture Garden, 2026)","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Inscription in museum files: \"Goats Horn with Red 1945/by Georgia O'Keeffe\" [Andrew Droth, An American Place3, black ink]. Whitney Archive indicates, \"Exam. at Amer. Place, March 1946.... No signature.\" Abiquiú Notebooks indicates, \"Note: Mrs. Watter is dead. The painting may be at Downtown Gallery again.\" (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"27 7/8 x 31 11/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Goat's Horn With Red, 1945. Pastel on paperboard mounted on paperboard, 27 7/8 x 31 11/16 inches. Hirshhorn Museum and Sculpture Garden. Hirshhorn Museum and Sculpture Garden, Smithsonian Institution, Washington, DC, Gift of Joseph H. Hirshhorn, 1972. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Pastel on paperboard mounted on paperboard, 27 7/8 x 31 11/16 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Hirshhorn Museum and Sculpture Garden, Smithsonian Institution, Washington, DC, Gift of Joseph H. Hirshhorn, 1972","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Goat's Horn With Red, 1945","type":"LinguisticObject"},{"classified_as":[{"_label":"extended_medium_description","id":"https://data.okeeffemuseum.org/terms/local/extended_medium_description"}],"content":"Pastel on medium thick, cream, slightly textured paper laminated to cardboard (Source: Paper Survey researched by Judith C. Walsh and published in Lynes, 1999.)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A goat's horn spirals in on itself, creating a large circle at the center of this semiabstract composition. The horn transitions from white at its base to bright red at its tip. The central circle of the composition is bright blue, while the outer area surrounding the horn is white.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Hirshhorn Museum and Sculpture Garden","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Pastel on paperboard mounted on paperboard","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794783/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/794783"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}