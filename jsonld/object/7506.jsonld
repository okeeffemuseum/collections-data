ed_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Victory canner - stainless steel, black bottom, wood handles slightly worn. Lid will not come off.  In original box with instruction booklet, etc. Original box - Handwritten: Sold to Georgia O'Keeffe 8-11-43. Espanola Mercantile, Espanola. Please be sure all parts are kept together with instruction book. Stamped on side of box: National Victory Cannery, Albuquerque Frt Asso 900 S. Wells, Chicago, ILL Chas. ILFELD Co. Albuquerque, N. Mex.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Canner, Victory Canner, ca. 1943","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Stainless steel, wood, cardboard","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"National Pressure Cooker, Co.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of The Georgia O'Keeffe Foundation","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/777524/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/777524"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/77