{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/9461","identified_by":[{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1081, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1081","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"9461","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery label.","title":"Black Place","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery label.","title":"Black Place – II","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Downtown Gallery label.","title":"Black Place #2","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Abiquiú Notebooks.","title":"Black Place No. II","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive.","title":"Black Place II","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Black Place II","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Black Place II, 1944. Oil on canvas, 23 7/8 x 30 inches. Metropolitan Museum of Art (The Met). Alfred Stieglitz Collection, 1959. © Metropolitan Museum of Art (The Met)","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The artist (1944–59; on extended loan to MMA, 1949–59; her gift as part of the Alfred Stieglitz Collection to MMA) (Source: The Met, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"23 7/8 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A thin, yellow stripe zigzags down the center of the composition. On either side, huge, smooth black and gray hills form a V-shape. Whisps of chalky white sand or mist swirl around the topmost hills.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Black Place II, 1944","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Metropolitan Museum of Art (The Met)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Metropolitan Museum of Art (The Met)","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Infor. from Miss Bry (An Amer. Place), July 1949: On permanent loan to the Metropolitan Museum of Art from Georgia O'Keeffe as part of the Alfred Stieglitz Coll.\" Inscription in Metropolitan Museum of Art file: \"Black Place – II\" (Andrew Droth, An American Place, black ink). (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 23 7/8 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Alfred Stieglitz Collection, 1959","type":"LinguisticObject"},{"classified_as":[{"_label":"selected_references","id":"https://data.okeeffemuseum.org/terms/local/selected_references"}],"content":"William S. Lieberman in Profil du Metropolitan Museum of Art de New York: de Ramsès à Picasso. Exh. cat., Galerie des Beaux-Arts, Bordeaux. Bordeaux, 1981, p. 174, no. 225, ill. \n \nLowery S. Sims in Profil du Metropolitan Museum of Art de New York: de Ramsès à Picasso. Exh. cat., Galerie des Beaux-Arts, Bordeaux. Bordeaux, 1981, pp. 166–67. \n \nLisa Mintz Messinger. \"Georgia O'Keeffe.\" Metropolitan Museum of Art Bulletin 42 (Fall 1984), pp. 54, 56–67, 61, ill. \n \nVera Graaf. \"Georgia O'Keefes Leben.\" Du no. 5 (May 1987), pp. 28–29, ill. \n \nLisa Mintz Messinger. Georgia O'Keeffe. New York, 1988, pp. 85–87, ill. \n \nMichael Berry. Georgia O'Keeffe. New York, 1988, pp. 90–91, ill. \n \nRoxana Robinson. Georgia O'Keeffe: A Life. New York, 1989, pp. 477–78. \n \nDoris Bry in Georgia O'Keeffe, in the West. Ed. Doris Bry and Nicholas Callaway. New York, 1989, pl. 60. \n \nElizabeth Montgomery. Georgia O'Keeffe. New York, 1993, p. 71, ill. \n \nLisa Mintz Messinger in The Georgia O'Keeffe Museum. Ed. Peter H. Hassrick. New York, 1997, p. 41, ill. \n \nBarbara Buhler Lynes. Georgia O'Keeffe: Catalogue Raisonné. New Haven, Conn., 1999, vol. 1, p. 683, no. 1081, ill. \n \nBarbara Buhler Lynes with Russell Bowman. O'Keeffe's O'Keeffes: The Artist's Collection. Exh. cat., Milwaukee Art Museum. New York, 2001, p. 169 (app. 2: \"Works Given to Institutions during the Artist's Lifetime\"). \n \nHunter Drohojowska-Philp. Full Bloom: The Art and Life of Georgia O'Keeffe. New York, 2004, ill. between pp. 376–77. \n \nLisa Mintz Messinger in Stieglitz and His Artists: Matisse to O'Keeffe. The Alfred Stieglitz Collection in The Metropolitan Museum of Art. Ed. Lisa Mintz Messinger. Exh. cat., The Metropolitan Museum of Art. New York, 2011, pp. 14, 205, 282, no. 193, ill. (color). \n \nIsabelle Duvernois in Stieglitz and His Artists: Matisse to O'Keeffe. The Alfred Stieglitz Collection in The Metropolitan Museum of Art. Ed. Lisa Mintz Messinger. Exh. cat., The Metropolitan Museum of Art. New York, 2011, p. 193. \n \nTanya Barson in Georgia O'Keeffe. Ed. Tanya Barson. Exh. cat., Tate Modern. London, 2016, p. 16, fig. 161 (color). \n \nWanda M. Corn. Georgia O'Keeffe: Living Modern. Exh. cat., Brooklyn Museum. Brooklyn, 2017, p. 160, fig.173 (color).","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/884926/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/884926"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalO