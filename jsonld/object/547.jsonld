femuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 18 3/4 x 24 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"18 3/4 x 24 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Norton Museum of Art, West Palm Beach, Florida, Bequest of R. H. Norton, 53.143","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A side view of Los Ranchos Church fills the composition. The walls of the church appear in varying shades of brown against a pale blue sky. A low buttress supports one of the protruding walls, which stands on a light brown slope.","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The Downtown Gallery, New York \n(Source: Norton Museum of Art, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Norton Museum of Art","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Ranchos Church No. I, 1929. Oil on canvas, 18 3/4 x 24 inches. Norton Museum of Art. Norton Museum of Art, West Palm Beach, Florida, Bequest of R. H. Norton, 53.143. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classi