{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/9018","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"L.2008.1.3","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"Unnumbered, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"9018","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"Unnumbered","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title":{"titles":[{"notes":"Source of title: backing inscription. See General Remarks.","title":"Canna Lily","type":"alternate-title"}],"type":"alternate-title"},"selected-exhibition-titles":{"titles":["Red Canna\nJo Whaley: Echos and 2018 Nov Thematic, 2018, Georgia O'Keeffe Museum (Santa Fe)"],"type":"selected-exhibition-titles"}},"type":"Name"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Canna Lily","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Loan, Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Canna Lily, 1919","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on board, 12 x 9 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_post_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_post_1999"}],"content":["This work was not examined at the time of the Lynes publication. Title, date, and medium Canna Lily, 1919 by Georgia O’Keeffe, oil on board, and dimensions as 12 x 9 based on backing inscription, installation photographs from the Anderson Galleries 1923 exhibition, and 2012 technical examination done by Dale Kronkright at the Georgia O'Keeffe Museum. It is possible that this work is listed in Appendix II as no. 18 or 39 as a recording error could have been made at the time of the Whitney Archive or Abiquiú Notebooks. It’s also possible that it is neither and is not recorded in Lynes, 1999. (Source: Georgia O'Keeffe Museum, 2025)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"12 x 9 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Canna Lily, 1919. Oil on board, 12 x 9 inches. Private Collection. Loan, Private Collection. © Georgia O'Keeffe Museum. [L.2008.1.3]","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on board","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Alfred Stieglitz to Alice Van Orden, c. 1923 \nDescended in family,1989 \nDescended in family, 2002 \nPrivate Collector, 2006 \n(Source: Georgia O'Keeffe Museum, 2025)","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}