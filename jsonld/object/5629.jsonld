{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300046300","label":"photographs","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/5629","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"5629","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2006.6.658rr","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Untitled (Helen Rockefeller)","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Ansel Adams","id":"actor/907","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Untitled (Helen Rockefeller), 1938","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Close up portrait of Helen Rockefeller with face turned to the right, wearing a wide brimmed hat with a chin strap, and a sleeveless black v-neck top.  This photograph is part of an album created by Ansel Adams after his 1938 trip to Yosemite with Georgia O'Keeffe, David McAlpin, and Helen and Godfrey Rockefeller. This is one of only three albums created for his travel companions documenting their trip.","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of The Georgia O'Keeffe Foundation","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Ansel Adams Publishing Rights Trust","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Gelatin silver print","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"6  7/8 x 3 3/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Gelatin silver print, 6 7/8 x 3 3/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Ansel Adams. Untitled (Helen Rockefeller), 1938. Gelatin silver print, 6 7/8 x 3 3/8 inches. Georgia O'Keeffe Museum. Gift of The Georgia O'Keeffe Foundation. © Ansel Adams Publishing Rights Trust. [2006.6.658rr]","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Ansel Adams","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799884/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799884"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"},{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/733593/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_