{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300266639","label":"clothing","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/7702","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"7702","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2000.3.363","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Dress, Sleeveless","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/300","type":"Actor"},{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Ivory on White embroidered stripes, sleeveless dress, Stand up collar, patch pockets, gathered from shoulders, button up front,  Placket with four buttons and snap enclosure at collar. Two patch pockets pleated at bottom of placket. Gathered shoulders, one additional button at collar. Pearl buttons.  Same design as 0392 - both appear home made; button holes hand made on this one large belt loops; seems like a home decorating fabric, could these be from a Claire McCardell original? USA?","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Unknown. Dress, Sleeveless, 20th Century