{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/9454","identified_by":[{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"1477","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"9454","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"1477, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Winter Road I","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Downtown Gallery Archive, Whitney Archive in 1969.","title":"The Winter Road","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Abiquiú Notebooks.","title":"Winter Road I","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"National Gallery of Art, Washington, Alfred Stieglitz Collection, Gift of The Georgia O'Keeffe Foundation, 1995.4.1","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["The stretcher once held \"Grey No 1, 1918,\" a now lost painting exhibited in 1923 at Anderson Galleries as no. 102. Inscription 1 may indicate preparatory work. \"303\" in stretcher inscription 4 refers to The Intimate Gallery, Room 303, in The Anderson Galleries building. See cat. nos. 1448–55, 1471. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Board of Trustees, National Gallery of Art, Washington","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"22 x 18 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A winding band of black unfurls over a plain white background. The black stripe evokes a road running over rolling hills covered with snow.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Winter Road I, 1963. Oil on canvas, 22 x 18 inches. National Gallery of Art (NGA). National Gallery of Art, Washington, Alfred Stieglitz Collection, Gift of The Georgia O'Keeffe Foundation, 1995.4.1. © Board of Trustees, National Gallery of Art, Washington","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"The artist [1887-1986]; estate of the artist; 1993 to The Georgia O'Keeffe Foundation, Abiquiú, New Mexico; gift 1995 to NGA. (Source: NGA, 2025)","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Winter Road I, 1963","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 22 x 18 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"National Gallery of Art (NGA)","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857700/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/857700"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}