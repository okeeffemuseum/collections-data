isticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Todd Webb. Georgia O'Keeffe, Ghost Ranch, 1962. Gelatin silver print, 9 5/16 x 7 9/16 inches. Georgia O'Keeffe Museum. Gift of The Georgia O'Keeffe Foundation. © Todd Webb Archive. [2006.6.990]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Portrait of O'Keeffe wrapped in a white blanket (resembling Mother Theresa or an aged Virgin Mary), quarter length view, body faces the camera with face looking down and slightly turned to viewer right, the white blanket is wrapped around O'Keeffe's face and head and around her shoulders and arms, her left arm  is bent in front of her waist (viewer right),a portion of white collar and part of a black garment can be seen under the blanket near O'Keeffe's neck.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Todd Webb","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"9 5/16 x 7 9/16 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/798851/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/798851"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}