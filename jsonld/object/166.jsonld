{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300033799","label":"oil paintings (visual works)","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300033618","label":"paintings (visual works)","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/166","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"166","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"L.1998.7.4","type":"Identifier"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":"819, Catalogue Raisonné","type":"Identifier"},{"classified_as":[{"_label":"catalogue raisonnée number","id":"https://vocab.getty.edu/aat/300026061"}],"content":"819","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Nature Forms – Gaspé","type":"Name"},{"classified_as":[{"_label":"non-preferred identifiers","id":"https://vocab.getty.edu/aat/300264273"}],"content":{"alternate-title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"The Wave","type":"alternate-title-1999-catalogue-raisonne"},{"notes":"Source of title: Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Nature Forms, Gaspe","type":"alternate-title-1999-catalogue-raisonne"}],"type":"alternate-title-1999-catalogue-raisonne"},"title-1999-catalogue-raisonne":{"titles":[{"notes":"Source of title: backing inscription 1, Whitney Archive, Downtown Gallery Archive, Abiquiú Notebooks.","title":"Nature Forms – Gaspé","type":"title-1999-catalogue-raisonne"}],"type":"title-1999-catalogue-raisonne"}},"type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. Nature Forms – Gaspé, 1932. Oil on canvas, 10 1/4 x 24 inches. Private Collection. © Private Collection*. [L.1998.7.4]","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"Estate of the artist (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"10 1/4 x 24 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Private Collection*","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Very intricate horizontal abstraction of wave-like swirls in white and blue in a rushing rippling sea of olive green tendons and teal veins.  The dominant spiraling eddy of white is in the upper middle right, while the main thrust of the olive green flows from upper left across to lower right.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 10 1/4 x 24 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Abiquiú Notebooks notes inscriptions 1,2. Abiquiú Notebooks after 1977 indicates \"On back: Alfred Stieglitz handwriting, \"An American Place/509 Madison Aven./NY/Georgia O'Keeffe\" [not verified]. Backing inscription 1, Downtown Gallery Archive, date 1931. Abiquiú Notebooks dates 1932. Dated 1932 on basis of the trips O'Keeffe made to Canada in June and August 1932. Pictured in 1933 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 54. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Nature Forms – Gaspé, 1932","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/886132/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/886132"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}