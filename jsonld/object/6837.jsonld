_medium_dims"}],"content":"Archival pigment print, 11 11/16 x 9 3/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Fred Stein. Georgia O'Keeffe, 1961$|2014. Archival pigment print, 11 11/16 x 9 3/8 inches. Georgia O'Keeffe Museum. Gift of Peter Stein, Fred Stein Archive. © Fred Stein Estate. [2014.6.1]","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Vertical portrait of Georgia O'Keeffe sitting at her dining room (plywood) table at Ghost Ranch looking at the camera with one hand on the table and the other resting on the chair back; her hair is pulled back in a bun and she is wearing a black wrap dress (with a white wrap dress underneath) and her Hector Aguilar suede and sterling silver belt.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Archival pigment print","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799350/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/799350"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}