{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300167850","label":"painting equipment","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/9800","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"RC.1998.1.850","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"9800","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Leather Suitcase with Initials A.S.","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":null,"id":"actor/1950","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Leather Suitcase with Initials A.S., 19th Century–20th Century","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Leather and brass, 6 x 24 x 14 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"6 x 24 x 14 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Crouch \u0026 Fitzgerald. Leather Suitcase with Initials A.S., 19th Century–20th Century. Leather and brass, 6 x 24 x 14 inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [RC.1998.1.850]","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Leather and brass","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Crouch \u0026 Fitzgerald","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"A dark leather suitcase manufactured by Crouch and \u0026 Fitzgerald, with brass hinges and locks and the initials  A.S. on the side.  The contents of the suitcase contains four(4) boxes of  wooden handled paintbrushes, with various thickness, mostly plain or varnished wood, some with painted red or black handles. The various manufacturers include: Artco; Bavaria; Grumbacher; Newman; Winsor Newton; Lucien Lefebvre-Foinet; Pelican; Rubens; Friedrichs; Sentry; and Diamond \u0026 Fitch. Of the four boxes of paint brushes in the suitcase: there are 2 brown boxes, 1 white box and 1 black box of bristle brushes.  There is an additional box - 1 blue box of miscellaneous supplies.","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/791322/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/791322"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}