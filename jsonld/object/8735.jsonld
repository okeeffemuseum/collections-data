and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"My Autumn, 1929","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"40 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. My Autumn, 1929. Oil on canvas, 40 x 30 inches. Private Collection. © Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Doris Bry, New York, NY); Private collection, Clearwater, Florida, 1976; Christie's, New York, NY, sale no. 8290, lot no. 46, 30 November 1995 (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Several large, smooth yellow leaves populate the canvas. A bright red oak leaf emerges from the cluster of yellow leaves. Other bright red leaves fill the background.","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 40 x 30 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive indicates, \"Exam. at Amer. Place, March 1946. . . . No signature. . . . Miss O'Keeffe says this is No. 23 in 1930 exh. and painted 1929.\" Pictured in 1930 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 35. (Source: Lynes, 1999)"],"type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824848/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/824848"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}