ription"}],"content":"3 x 6 1/2 x 1 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Winsor \u0026 Newton Ltd","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Winsor \u0026 Newton Box of Oil Paint, 1920–1989","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Cardboard, oil paint and metal, 3 x 6 1/2 x 1 1/4 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Winsor \u0026 Newton Ltd. Winsor \u0026 Newton Box of Oil Paint, 1920–1989. Cardboard, oil paint and metal, 3 x 6 1/2 x 1 1/4 inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [RC.1998.1.702]","type":"LinguisticObject"}],"representation":[],"type":"HumanMadeObject"}