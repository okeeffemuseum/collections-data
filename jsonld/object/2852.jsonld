{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300404584","label":"household accessories","type":"Type"},{"_id":"http://vocab.getty.edu/aat/300199765","label":"culinary equipment","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/2852","identified_by":[{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"2852","type":"Identifier"},{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2000.5.261a-d","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Container, Tea","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Unknown","id":"actor/300","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Black metal tea container with black lid. Top of lid has bronze border with Asian art motifs in center. Center circle reads \"First Grade\". Sides of jar has register of Asian letters and floral illustrations in gold on a white ground. Below is a border of Asian letters in gold on a black ground. Below is a band of gold vertical lines on a black ground. Under lid is a gold colored inset lid. On top of inset lid sits a small, circular paper booklet with an illustrated \"Pi Lo Chun\" logo and tea making instructions surrounded by art motifs in green ink. English instructions on one side, Chinese on the other. Bottom of container is silver metal.","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"3 9/16 H x 2 15/16 Diam inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Unknown. Container, Tea, 20th Century. Metal, paper, 3 9/16 H x 2 15/16 Diam inches. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.5.261a-d]","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Metal, paper","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Metal, paper, 3 9/16 H x 2 15/16 Diam inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Container, Tea, 20th Century","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Unknown","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/776120/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/776120"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/con