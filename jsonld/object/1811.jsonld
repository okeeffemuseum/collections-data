{"classified_as":[{"_id":"http://vocab.getty.edu/aat/300266639","label":"clothing","type":"Type"},{"_label":"Collection Item","id":"https://vocab.getty.edu/aat/300404024","type":"Type"}],"id":"https://data.okeeffemuseum.org/object/1811","identified_by":[{"classified_as":[{"_label":"accession number","id":"https://vocab.getty.edu/aat/300312355"}],"content":"2000.3.421a-b","type":"Identifier"},{"classified_as":[{"_label":"repository number","id":"https://vocab.getty.edu/aat/300404621"}],"content":"1811","type":"Identifier"},{"classified_as":[{"_label":"preferred term","id":"https://vocab.getty.edu/aat/300404670"}],"content":"Smock, Dress and Sash, Belt","type":"Name"}],"produced_by":{"carried_out_by":[{"_label":"Marimekko","id":"actor/430","type":"Actor"},{"_label":"Armi Ratia","id":"actor/1027","type":"Actor"},{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Marimekko, Armi Ratia","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"Smock, Dress and Sash, Belt, 1950s, 1953–1960s","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Cotton, fiber","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"a: Smock Dress b: Sash. a: Black and brown stripe, button up front smock, stand up high collar, 3/4 sleeves, large patch pockets, gathered on back top.  \"Marimekko\". b:  Fabric belt; same material as dress; it has been let down. 2 looped ribbon label and collar label.  Label tape labels 50s early \"Marimekko Fineland 100% cotton\" \"Design Research Cambridge\" O'K probably acquired this one first.  Designer Armi Ratia Name of the dress Äidin takki (=Mother's coat) Designed in the beginning of 1950s. Pattern called Ristipiccolo, designed by Vuokko Nurmesiemi, 1953.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Unknown","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Marimekko, Armi Ratia. Smock, Dress and Sash, Belt, 1950s$|1953–1960s. Cotton, fiber, Dress: 44 W x 46 3/4 L inches ^Sash: 1 1/8 W x 48 1/2 L inches ^Size: 14 ^ ^A: 46 L x 39 W LFH ^B: 48 1/2 L x 1 1/4W CB. Georgia O'Keeffe Museum. Gift of Juan and Anna Marie Hamilton. © Unknown. [2000.3.421a-b]","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"Dress: 44 W x 46 3/4 L inches \nSash: 1 1/8 W x 48 1/2 L inches \nSize: 14 \n \nA: 46 L x 39 W LFH \nB: 48 1/2 L x 1 1/4W CB","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"credit line","id":"https://vocab.getty.edu/aat/300026687"}],"content":"Gift of Juan and Anna Marie Hamilton","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Cotton, fiber, Dress: 44 W x 46 3/4 L inches ^Sash: 1 1/8 W x 48 1/2 L inches ^Size: 14 ^ ^A: 46 L x 39 W LFH ^B: 48 1/2 L x 1 1/4W CB","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/793515/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.get