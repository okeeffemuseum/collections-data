y":[{"_label":"Georgia O'Keeffe","id":"actor/2","type":"Actor"}],"timespan":{"type":"TimeSpan"},"type":"Production"},"referred_to_by":[{"classified_as":[{"_label":"Caption - Copyright","id":"https://data.okeeffemuseum.org/terms/caption_copyright"}],"content":"© Georgia O'Keeffe Museum","type":"LinguisticObject"},{"classified_as":[{"_label":"Measurement Description","id":"https://data.okeeffemuseum.org/terms/measurement_description"}],"content":"48 1/8 x 29 7/8 inches","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Title and Date","id":"https://data.okeeffemuseum.org/terms/caption_title_date"}],"content":"A Street, 1926","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Holding Institution","id":"https://data.okeeffemuseum.org/terms/caption_instituion"}],"content":"Private Collection","type":"LinguisticObject"},{"classified_as":[{"_label":"Materials description","id":"https://data.okeeffemuseum.org/terms/materials_description"}],"content":"Oil on canvas","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Complete","id":"https://data.okeeffemuseum.org/terms/caption_complete"}],"content":"Georgia O'Keeffe. A Street, 1926. Oil on canvas, 48 1/8 x 29 7/8 inches. Private Collection. © Georgia O'Keeffe Museum. [1997.6.22]","type":"LinguisticObject"},{"classified_as":[{"_label":"cr_remarks_1999","id":"https://data.okeeffemuseum.org/terms/local/cr_remarks_1999"}],"content":["Whitney Archive, Abiquiú Notebooks indicates, \"Exam at Amer. Place, March 1946.\" Whitney Archive indicates, \"No signature. on backing: Label, 'A Street 1925'\" [not verified]. Whitney Archive, Abiquiú Notebooks indicate, \"Note: Possibly one of the New York street series in he 1927 exhibition and painted 1926. Georgia O'Keeffe verifies this as 'Street New York No. 1' Ptd. 1926.\" Pictured in 1935 New York (An American Place) Stieglitz installation photograph, see Appendix III, figure 58. (Source: Lynes, 1999)"],"type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Artist(s)","id":"https://data.okeeffemuseum.org/terms/caption_artist"}],"content":"Georgia O'Keeffe","type":"LinguisticObject"},{"classified_as":[{"_label":"provenance_narrative","id":"https://data.okeeffemuseum.org/terms/local/provenance_narrative"}],"content":"(Alfred Stieglitz, New York, N.Y.) \nMr. Robert Dowling, New York, N.Y., 1920s \nFrench \u0026 Company, New York, N.Y., unknown \nMaxwell Galleries, Ltd., San Francisco, Calif., 1968 \nPrivate collection, Atherton Calif., 1968 \nGagosian Gallery, New York, N.Y., 1990 \nSteve Martin, 1990 \n(Gerald Peters Gallery, Santa Fe, N.Mex.) \nThe Burnett Foundation, Fort Worth, Tex., 1996 (Source: Lynes, 1999)","type":"LinguisticObject"},{"classified_as":[{"_label":"description statement","id":"https://vocab.getty.edu/aat/300435416"}],"content":"Large vertical canvas of brown, gold, and black nondescript buildings on either side of a street creating a canyon from either side.  At the end of this is a single light post.  The sky in between is grey tinged with brown and blue.","type":"LinguisticObject"},{"classified_as":[{"_label":"Caption - Medium and Dimensions","id":"https://data.okeeffemuseum.org/terms/caption_medium_dims"}],"content":"Oil on canvas, 48 1/8 x 29 7/8 inches","type":"LinguisticObject"}],"representation":[{"digitally_shown_by":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/886140/full/full/0/default.jpg","type":"DigitalObject"}],"classified_as":[{"_label":"Digital Image","id":"http://vocab.getty.edu/aat/300215302","type":"Type"}],"digitally_available_via":[{"access_point":[{"id":"https://iiif.okeeffemuseum.org/image/iiif/2/886140"}],"conforms_to":[{"id":"http://iiif.io/api/image","type":"InformationObject"}],"format":"application/ld+json;profile='http://iiif.io/api/image/2/context.json'","type":"DigitalService"}],"type":"DigitalObject"}],"type":"VisualItem"}],"type":"HumanMadeObject"}